---
import AppLayout from '../../layouts/AppLayout.astro';
import { asset } from '../../lib/asset.js';
import { visualWork } from '../../data/site.js';
import { projectDetails } from '../../data/portfolio-detail.js';


const _base = import.meta.env.BASE_URL || '/';
const b = _base.endsWith('/') ? _base : _base + '/';


// A work only links out when portfolio/[slug] actually builds a page for it.
// 10 of the 18 have no entry here — every video-art piece and four theater
// designs — so linking them unconditionally shipped 404s.
const detailSlugs = new Set(projectDetails.map(p => p.slug));

// Newest first. Years can be ranges ("2014–16", "2016 / 2018"), so sort on the
// latest year mentioned rather than parseInt of the whole string.
const latestYear = (w) => {
  const years = String(w.year).match(/\d{4}/g);
  return years ? Math.max(...years.map(Number)) : 0;
};
const byYearDesc = (a, bk) => latestYear(bk) - latestYear(a);

// Only works with photography are shown for now. That currently empties
// Theater Design, so the filter bar is derived from the categories actually
// present rather than hardcoded — no button that leads to an empty grid.
const works = visualWork.filter(w => w.images?.length).sort(byYearDesc);

const CATS = [
  { key: 'installation', label: 'Installation' },
  { key: 'video-art',    label: 'Video Art' },
  { key: 'design',       label: 'Theater Design' },
];
const filters = [
  { key: 'all', label: 'All' },
  ...CATS.filter(c => works.some(w => w.cat === c.key)),
];

// One mixed stream, newest first. Each type carries its own mark in the meta
// line so they stay tellable apart without separate bands.
const ICONS = {
  'installation': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="M12 12 4 7.5M12 12l8-4.5M12 12v9"/></svg>',
  'video-art':    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="m10 9.5 5 2.5-5 2.5z"/></svg>',
  'design':       '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h18M5 4v6a7 7 0 0 0 14 0V4"/><path d="M9 21h6M12 17v4"/></svg>',
};
---
<AppLayout title="Visual Art — Guillermo Laporta" description="Installation, video art and theater design — visual works by Guillermo Laporta.">
  <div class="subpage-head">
    <a class="subpage-back" href={b}>← Home</a>
    <div class="subpage-num">Visual Art</div>
    <h1 class="subpage-title">Visual art.</h1>
    <p class="subpage-sub">Installation, video art and theater design — as composer, director and designer.</p>
  </div>

  <section class="section section-tight">
    <div class="filter-bar" id="filterBar">
      {filters.map((f) => (
        <button class={`filter-btn${f.key === 'all' ? ' active' : ''}`} data-cat={f.key}>
          {f.label}
        </button>
      ))}
    </div>

    <div class="proj-grid" id="projGrid">
      {works.map((p) => {
        const imgs = p.images;
        const hasDetail = detailSlugs.has(p.slug);
        return (
          <article class={`proj-card cat-${p.cat}`} data-cat={p.cat}>
            {imgs.length > 0 && (
              <div class="proj-media">
                {imgs.length > 1 ? (
                  <div class="proj-gallery-wrap" data-count={imgs.length}>
                    <div class="proj-carousel">
                      {imgs.map((img, i) => (
                        <div class="proj-slide">
                          <img
                            src={asset(img)}
                            alt={`${p.title} — ${i + 1}`}
                            loading={i === 0 ? 'eager' : 'lazy'}
                            draggable="false"
                          />
                        </div>
                      ))}
                    </div>
                    <div class="proj-counter">
                      <span class="pc-cur">1</span> / {imgs.length}
                    </div>
                  </div>
                ) : (
                  <div class="proj-img-wrap">
                    <img class="proj-img" src={asset(imgs[0])} alt={p.title} loading="lazy" />
                  </div>
                )}
              </div>
            )}
            <div class="proj-body">
              <div class="proj-meta">
                <span class="proj-year">{p.year}</span>
                <span class="proj-kind">
                  <span class="proj-icon" set:html={ICONS[p.cat]} />
                  {p.kind}
                </span>
              </div>
              {hasDetail
                ? <a class="proj-title-link" href={`${b}portfolio/${p.slug}/`}><h3 class="proj-title">{p.title}</h3></a>
                : <h3 class="proj-title">{p.title}</h3>}
              {p.desc && <p class="proj-desc">{p.desc}</p>}
              {hasDetail && (
                <a class="proj-cta" href={`${b}portfolio/${p.slug}/`}>
                  View project
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4"/>
                  </svg>
                </a>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <script>
    /* ── filter ── */
    const bar  = document.getElementById('filterBar');
    const grid = document.getElementById('projGrid');
    bar.addEventListener('click', e => {
      const btn = e.target.closest('.filter-btn');
      if (!btn) return;
      bar.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const cat = btn.dataset.cat;
      grid.querySelectorAll('.proj-card').forEach(card => {
        card.hidden = !(cat === 'all' || card.dataset.cat === cat);
      });
    });

    /* ── carousels ── */
    const ARROW = dir =>
      `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="${dir < 0 ? 'M15 5l-7 7 7 7' : 'M9 5l7 7-7 7'}"/></svg>`;

    document.querySelectorAll('.proj-gallery-wrap').forEach(wrap => {
      const carousel = wrap.querySelector('.proj-carousel');
      const curEl    = wrap.querySelector('.pc-cur');
      const total    = carousel.children.length;

      /* dots — make the extra frames visible without interaction */
      const dots = document.createElement('div');
      dots.className = 'proj-dots';
      for (let i = 0; i < total; i++) {
        const d = document.createElement('button');
        d.type = 'button';
        d.className = 'proj-dot' + (i === 0 ? ' on' : '');
        d.setAttribute('aria-label', `Image ${i + 1} of ${total}`);
        d.addEventListener('click', () => {
          carousel.scrollTo({ left: i * carousel.offsetWidth, behavior: 'smooth' });
        });
        dots.appendChild(d);
      }
      wrap.appendChild(dots);

      /* arrows — pointer devices only */
      const prev = document.createElement('button');
      const next = document.createElement('button');
      prev.type = next.type = 'button';
      prev.className = 'proj-nav prev';
      next.className = 'proj-nav next';
      prev.innerHTML = ARROW(-1);
      next.innerHTML = ARROW(1);
      prev.setAttribute('aria-label', 'Previous image');
      next.setAttribute('aria-label', 'Next image');
      const step = dir => carousel.scrollBy({ left: dir * carousel.offsetWidth, behavior: 'smooth' });
      prev.addEventListener('click', () => step(-1));
      next.addEventListener('click', () => step(1));
      wrap.append(prev, next);

      function updateCounter() {
        const w   = carousel.offsetWidth;
        const idx = w > 0 ? Math.round(carousel.scrollLeft / w) : 0;
        curEl.textContent = idx + 1;
        dots.querySelectorAll('.proj-dot').forEach((d, i) => d.classList.toggle('on', i === idx));
        prev.hidden = idx <= 0;
        next.hidden = idx >= total - 1;
      }
      carousel.addEventListener('scroll', updateCounter, { passive: true });
      updateCounter();

      let down = false, originX = 0, originScroll = 0;
      carousel.addEventListener('mousedown', e => {
        down         = true;
        originX      = e.clientX;
        originScroll = carousel.scrollLeft;
        carousel.style.cursor = 'grabbing';
        e.preventDefault();
      });
      window.addEventListener('mouseup', () => { if (down) { down = false; carousel.style.cursor = ''; } });
      window.addEventListener('mousemove', e => {
        if (!down) return;
        carousel.scrollLeft = originScroll - (e.clientX - originX) * 1.4;
      });
    });
  </script>

  <style>
    .section-tight{padding-top:0;max-width:1480px;margin:0 auto;padding-left:40px;padding-right:40px;padding-bottom:96px}
    @media(max-width:720px){.section-tight{padding-left:20px;padding-right:20px;padding-bottom:56px}}

    .filter-bar{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:32px}
    .filter-btn{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;padding:7px 16px;border:1px solid var(--line-soft);background:transparent;color:var(--muted);cursor:pointer;transition:all .15s ease;white-space:nowrap}
    .filter-btn:hover{border-color:var(--accent);color:var(--accent)}
    .filter-btn.active{background:var(--accent);border-color:var(--accent);color:#fff}
    @media(max-width:720px){
      .filter-bar{flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:4px;scrollbar-width:none;margin-left:-20px;margin-right:-20px;padding-left:20px;padding-right:20px}
      .filter-bar::-webkit-scrollbar{display:none}
    }

    .proj-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px}
    @media(max-width:1100px){.proj-grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:600px){.proj-grid{grid-template-columns:1fr}}


    .proj-card{display:flex;flex-direction:column;background:var(--surface);border:1px solid var(--line-soft);overflow:hidden}
    /* .proj-card's display:flex outranks the browser's [hidden] rule, so the
       filter needs this to actually hide a card. */
    .proj-card[hidden]{display:none}

    /* single image */
    .proj-img-wrap{aspect-ratio:16/9;overflow:hidden;background:var(--line-soft)}
    .proj-img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}
    .proj-card:hover .proj-img{transform:scale(1.03)}


    /* carousel */
    .proj-gallery-wrap{position:relative;aspect-ratio:16/9;overflow:hidden}
    .proj-carousel{
      display:flex;
      width:100%;height:100%;
      overflow-x:scroll;
      scroll-snap-type:x mandatory;
      scrollbar-width:none;
      -webkit-overflow-scrolling:touch;
      cursor:grab;
    }
    .proj-carousel::-webkit-scrollbar{display:none}
    .proj-slide{
      flex:0 0 100%;
      scroll-snap-align:start;
      overflow:hidden;
    }
    .proj-slide img{
      width:100%;height:100%;
      object-fit:cover;display:block;
      user-select:none;-webkit-user-drag:none;
    }
    .proj-counter{
      position:absolute;bottom:10px;right:12px;
      font-family:var(--mono);font-size:9px;letter-spacing:.10em;
      color:#fff;background:rgba(0,0,0,.45);
      padding:3px 8px;
      backdrop-filter:blur(4px);
      pointer-events:none;
    }

    /* ── swipe affordance ──────────────────────────────────────
       Nothing signalled that a carousel had more than one image. Dots make
       the extra frames visible at rest; arrows appear on pointer devices. */
    .proj-dots{
      position:absolute;bottom:10px;left:12px;
      display:flex;gap:5px;align-items:center;
      padding:5px 8px;border-radius:999px;
      background:rgba(0,0,0,.45);backdrop-filter:blur(4px);
    }
    .proj-dot{
      width:5px;height:5px;border-radius:50%;padding:0;border:none;
      background:rgba(255,255,255,.42);cursor:pointer;transition:background .18s,transform .18s;
    }
    .proj-dot.on{background:#fff;transform:scale(1.35)}

    .proj-nav{
      position:absolute;top:50%;transform:translateY(-50%);
      width:30px;height:30px;border:none;border-radius:50%;
      display:grid;place-items:center;
      background:rgba(0,0,0,.42);color:#fff;cursor:pointer;
      opacity:0;transition:opacity .18s;backdrop-filter:blur(4px);
    }
    .proj-nav svg{width:14px;height:14px}
    .proj-nav.prev{left:8px}
    .proj-nav.next{right:8px}
    .proj-gallery-wrap:hover .proj-nav{opacity:1}
    .proj-nav:focus-visible{opacity:1}
    .proj-nav[hidden]{display:none}
    @media(hover:none){ .proj-nav{display:none} }

    /* body */
    .proj-body{padding:24px 28px 28px;display:flex;flex-direction:column;flex:1}
    @media(max-width:600px){.proj-body{padding:18px}}
    .proj-meta{display:flex;align-items:center;gap:12px;margin-bottom:8px}
    .proj-year{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-2)}
    /* Was var(--line) — the hairline colour, 1.26:1 on paper, effectively
       invisible. Accent carries it at 4.68:1 and marks the type. */
    .proj-kind{display:inline-flex;align-items:center;gap:6px;font-family:var(--mono);font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:var(--accent);font-weight:500;padding-left:12px;border-left:1px solid var(--line-soft)}
    /* Each type carries its own mark, since the cards otherwise look alike. */
    .proj-icon{display:inline-flex;flex-shrink:0}
    .proj-icon svg{width:13px;height:13px;display:block}

    .proj-title-link{text-decoration:none;color:inherit}
    .proj-title{font-family:var(--serif);font-size:22px;font-weight:400;line-height:1.15;letter-spacing:-.015em;color:var(--ink);margin-bottom:10px;transition:color .15s}
    .proj-title-link:hover .proj-title{color:var(--accent)}
    @media(max-width:600px){.proj-title{font-size:19px}}

    .proj-desc{font-size:13px;line-height:1.65;color:var(--ink-2);font-weight:400;flex:1;max-width:54ch;margin-bottom:16px}

    .proj-cta{
      display:inline-flex;align-items:center;gap:6px;margin-top:auto;
      font-family:var(--mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;
      color:var(--muted);text-decoration:none;
      transition:color .15s;
      border-top:1px solid var(--line-soft);
      padding-top:14px;
    }
    .proj-cta svg{width:11px;height:11px;flex-shrink:0;transition:transform .15s}
    .proj-cta:hover{color:var(--accent)}
    .proj-cta:hover svg{transform:translateX(3px)}
  </style>
</AppLayout>
