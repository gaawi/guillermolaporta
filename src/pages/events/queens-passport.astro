---
import AppLayout from '../../layouts/AppLayout.astro';
import { asset } from '../../lib/asset.js';
import { grant } from '../../data/grant.js';

const _base = import.meta.env.BASE_URL || '/';
const b = _base.endsWith('/') ? _base : _base + '/';

// Every fact on this page is taken from the event's own boarding-pass poster.
// Nothing about the programme, the performers or the partners is added to it.
const event = {
  title: 'The Queens Passport',
  subtitle: 'For kids and families, with the Ivalas Quartet',
  date: '2026-11-19',
  displayDate: 'Thursday, November 19, 2026',
  boarding: '6:00 PM',
  arrival: '7:00 PM',
  fare: 'Free · Gratis',
  venue: 'Hunters Point Library',
  address: '47-40 Center Boulevard, Long Island City, NY 11109',
  onBoard: [
    'Kids conduct the musicians',
    'New music inspired by the neighbourhood',
    'Passport stamp and bilingual activity book',
  ],
  phone: '(718) 707-9944',
  phoneHref: 'tel:+17187079944',
  info: 'queenslibrary.org',
  infoHref: 'https://www.queenslibrary.org/',
};

const mapHref =
  'https://www.google.com/maps/search/?api=1&query=' +
  encodeURIComponent(`${event.venue}, ${event.address}`);
---
<AppLayout
  title={`${event.title} · Guillermo Laporta`}
  description={`${event.title}: a free bilingual concert for kids and families with the Ivalas Quartet at Hunters Point Library, Long Island City, on Thursday 19 November 2026.`}
>
  <div class="subpage-head">
    <a class="subpage-back" href={`${b}calendar/`}>← Calendar</a>
    <div class="subpage-num">Event · Evento</div>
    <h1 class="subpage-title">{event.title}</h1>
    <p class="subpage-sub">{event.subtitle}</p>
    <p class="subpage-sub" style="margin-top:6px">
      The pilot of <a class="ev-link" href={`${b}queens-musical-passport/`}><em>{grant.project}</em></a>,
      a project by {grant.grantee}
    </p>
  </div>

  <section class="ev">

    <div class="ev-grid">

      <!-- ── the facts ─────────────────────────────────────── -->
      <div class="ev-main">
        <dl class="ev-facts">
          <div class="ev-fact ev-fact-wide">
            <dt>Date · Fecha</dt>
            <dd class="is-big">{event.displayDate}</dd>
          </div>
          <div class="ev-fact">
            <dt>Boarding · Embarque</dt>
            <dd class="is-big">{event.boarding}</dd>
          </div>
          <div class="ev-fact">
            <dt>Arrival · Llegada</dt>
            <dd class="is-big">{event.arrival}</dd>
          </div>
          <div class="ev-fact">
            <dt>Fare · Tarifa</dt>
            <dd class="is-big">{event.fare}</dd>
          </div>
          <div class="ev-fact ev-fact-wide">
            <dt>Gate · Puerta</dt>
            <dd class="is-big">{event.venue}</dd>
            <dd class="is-sub">
              <a class="ev-link" href={mapHref} target="_blank" rel="noopener">{event.address} ↗</a>
            </dd>
          </div>
        </dl>

        <div class="ev-board">
          <div class="ev-label">On board · A bordo</div>
          <ul class="ev-list">
            {event.onBoard.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <p class="ev-about">
          An hour for children and whoever brings them. The quartet plays, the children take
          a turn conducting, and the new music on the programme was written about the
          neighbourhood the library sits in. Admission is free and no ticket is needed, and
          the activity book is in English and Spanish.
        </p>

        <div class="ev-contact">
          <div class="ev-label">Activities · Actividades</div>
          <p style="margin-bottom:22px">
            <a class="ev-link" href={`${b}queens-musical-passport/play/`}>Keep playing at home · Sigue jugando en casa →</a>
          </p>
          <div class="ev-label">Information · Información</div>
          <p>
            <a class="ev-link" href={event.phoneHref}>{event.phone}</a>
            <span class="ev-sep">·</span>
            <a class="ev-link" href={event.infoHref} target="_blank" rel="noopener">{event.info} ↗</a>
          </p>
        </div>
      </div>

      <!-- ── the poster ────────────────────────────────────── -->
      <figure class="ev-poster">
        <img src={asset('images/events/queens-passport-poster.jpg')}
             width="1056" height="1632" loading="eager"
             alt={`Boarding-pass poster for ${event.title}: ${event.displayDate}, ${event.venue}, free admission`} />
        <figcaption>The boarding pass · La tarjeta de embarque</figcaption>
      </figure>
    </div>

    <!-- ── credits ─────────────────────────────────────────────
         The sentence comes from src/data/grant.js, which holds it verbatim
         from clause 5.J of the signed contract. Change it there, never here.
    ────────────────────────────────────────────────────────── -->
    <div class="ev-credits">
      <div class="ev-label">Supported by · Con el apoyo de</div>
      <div class="ev-support">
        <a class="ev-logo" href={grant.administratorUrl} target="_blank" rel="noopener">
          <img src={asset(grant.logo)} width={grant.logoWidth} height={grant.logoHeight}
               loading="lazy" alt={grant.administrator} />
        </a>
        <div class="ev-credit-text">
          <p lang="en">{grant.credit}</p>
        </div>
      </div>

      <div class="ev-label" style="margin-top:40px">Presented at · Presentado en</div>
      <p class="ev-host">
        <a class="ev-link" href={event.infoHref} target="_blank" rel="noopener">
          {event.venue}, Queens Public Library ↗
        </a>
      </p>
    </div>
  </section>

  <style>
    .ev{max-width:1480px;margin:0 auto;padding:0 40px 96px}
    @media(max-width:720px){.ev{padding:0 20px 56px}}

    .ev-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,420px);gap:56px;align-items:start}
    @media(max-width:900px){.ev-grid{grid-template-columns:1fr;gap:40px}}

    /* ── facts ── */
    .ev-facts{
      display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin:0 0 36px;
      border-top:1px solid var(--line);
    }
    @media(max-width:600px){.ev-facts{grid-template-columns:repeat(2,1fr)}}
    .ev-fact{padding:16px 0 18px;border-bottom:1px solid var(--line-soft)}
    .ev-fact-wide{grid-column:1 / -1}
    .ev-facts dt{
      font-family:var(--mono);font-size:9.5px;letter-spacing:.16em;
      text-transform:uppercase;color:var(--muted);margin-bottom:7px;
    }
    .ev-facts dd{margin:0}
    .ev-facts .is-big{
      font-family:var(--serif);font-weight:500;font-size:clamp(20px,2.3vw,28px);
      line-height:1.15;letter-spacing:-.018em;color:var(--ink);
    }
    .ev-facts .is-sub{margin-top:5px;font-size:14px;line-height:1.45;color:var(--ink-2)}

    .ev-label{
      font-family:var(--mono);font-size:9.5px;letter-spacing:.16em;
      text-transform:uppercase;color:var(--muted);margin-bottom:12px;
    }

    .ev-list{list-style:none;margin:0;padding:0;display:grid;gap:10px;max-width:46ch}
    .ev-list li{
      position:relative;padding-left:26px;
      font-size:16px;line-height:1.45;color:var(--ink);
    }
    /* A tick box, like the one printed on the pass. */
    .ev-list li::before{
      content:"";position:absolute;left:0;top:.2em;
      width:13px;height:13px;border:1.5px solid var(--accent);border-radius:2px;
    }

    .ev-about{
      margin-top:34px;max-width:58ch;
      font-size:16.5px;line-height:1.62;color:var(--ink-2);
    }

    .ev-contact{margin-top:34px;padding-top:24px;border-top:1px solid var(--line-soft)}
    .ev-contact p{font-size:16px;color:var(--ink)}
    .ev-sep{color:var(--muted);margin:0 10px}
    .ev-link{color:var(--ink);border-bottom:1px solid var(--line);padding-bottom:2px;transition:color .18s,border-color .18s}
    .ev-link:hover{color:var(--accent);border-color:var(--accent)}

    /* ── poster ── */
    .ev-poster{margin:0}
    .ev-poster img{
      display:block;width:100%;height:auto;
      border:1px solid var(--line);border-radius:3px;
      box-shadow:0 24px 48px -34px rgba(0,0,0,.45);
    }
    .ev-poster figcaption{
      margin-top:12px;font-family:var(--mono);font-size:9.5px;letter-spacing:.14em;
      text-transform:uppercase;color:var(--muted);
    }

    /* ── credits ── */
    .ev-credits{margin-top:72px;padding-top:32px;border-top:1px solid var(--line-soft)}

    .ev-support{display:grid;grid-template-columns:auto minmax(0,1fr);gap:30px;align-items:start}
    @media(max-width:720px){.ev-support{grid-template-columns:1fr;gap:20px}}
    .ev-logo{opacity:.95;transition:opacity .18s}
    .ev-logo:hover{opacity:1}
    .ev-logo img{display:block;height:96px;width:auto}

    .ev-credit-text{max-width:64ch}
    .ev-credit-text p{font-size:14px;line-height:1.6;color:var(--ink-2)}
    .ev-credit-text p + p{margin-top:12px;padding-top:12px;border-top:1px solid var(--line-soft)}

    .ev-host{font-size:16px;color:var(--ink)}
  </style>
</AppLayout>
