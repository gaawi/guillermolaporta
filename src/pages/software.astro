---
import AppLayout from '../layouts/AppLayout.astro';
import { software } from '../data/software.js';

const _base = import.meta.env.BASE_URL || '/';
const b = _base.endsWith('/') ? _base : _base + '/';

// Deliberately an index and nothing more: no screenshots, no descriptions, no
// feature lists, no stack. The section is not finished, and a thin list reads
// as a list, while a thin card reads as a page that is missing something.
//
// None of that content is gone. It is all still in src/data/software.js, and
// the images are still in public/images/software/, so putting the detail back
// is a change to this template alone.
//
// Newest first. Gaawi is dated by when the studio started, not by its last job.
const items = [...software].sort((a, c) => Number(c.year) - Number(a.year));
---
<AppLayout
  title="Software · Guillermo Laporta"
  description="Apps, platforms and tools built by Guillermo Laporta, from the CreArtBox app to the tools that run the day's work."
>
  <div class="subpage-head">
    <a class="subpage-back" href={b}>← Home</a>
    <div class="subpage-num">Software</div>
    <h1 class="subpage-title">Things I build.</h1>
    <p class="subpage-sub">
      Apps, platforms and tools. Some of it carries the music; the rest runs the work
      around it.
    </p>
  </div>

  <section class="section-tight">
    <ol class="sw-index">
      {items.map((s, i) => (
        <li class="sw-row">
          <span class="sw-i">{String(i + 1).padStart(2, '0')}</span>
          <span class="sw-name">{s.name}</span>
          <span class="sw-kind">{s.kind}</span>
          <span class="sw-year">{s.year}</span>
          <span class="sw-go">
            {s.caseStudy && <a class="sw-a sw-a-case" href={`${b}${s.caseStudy}`}>Case study</a>}
            {s.url && <a class="sw-a" href={s.url} target="_blank" rel="noopener">{s.urlLabel}&nbsp;↗</a>}
          </span>
        </li>
      ))}
    </ol>
  </section>

  <style>
    .section-tight{max-width:1100px;margin:0 auto;padding:0 40px 110px}
    @media(max-width:720px){.section-tight{padding:0 20px 64px}}

    .sw-index{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}

    .sw-row{
      display:grid;
      /* The last column is fixed, not auto: with auto it grew or shrank with
         the number of links in each row and dragged the kind and year columns
         out of line. */
      grid-template-columns:34px minmax(0,1fr) 110px 52px 200px;
      align-items:baseline;gap:18px;
      padding:20px 2px;
      border-bottom:1px solid var(--line-soft);
    }

    .sw-i{
      font-family:var(--mono);font-size:10px;letter-spacing:.12em;color:var(--muted);
    }
    .sw-name{
      font-family:var(--serif);font-weight:500;font-size:22px;
      letter-spacing:-.015em;line-height:1.15;color:var(--ink);
    }
    .sw-kind,.sw-year{
      font-family:var(--mono);font-size:10px;letter-spacing:.12em;
      text-transform:uppercase;color:var(--muted);
    }
    .sw-go{display:flex;flex-wrap:wrap;gap:16px;justify-content:flex-end}
    .sw-a{
      font-family:var(--mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;
      color:var(--ink-2);border-bottom:1px solid var(--line);padding-bottom:3px;
      white-space:nowrap;transition:color .18s,border-color .18s;
    }
    .sw-a:hover{color:var(--accent);border-color:var(--accent)}
    .sw-a-case{color:var(--accent);border-color:var(--accent)}

    /* On a phone the row folds: name across the top, then the rest under it. */
    @media(max-width:720px){
      .sw-row{
        grid-template-columns:28px minmax(0,1fr);
        gap:4px 14px;padding:16px 2px;
      }
      .sw-name{grid-column:2;font-size:19px}
      .sw-kind{grid-column:2;grid-row:2}
      .sw-year{grid-column:2;grid-row:2;justify-self:start;margin-left:92px}
      .sw-go{grid-column:2;grid-row:3;justify-content:flex-start;margin-top:8px}
    }
  </style>
</AppLayout>
