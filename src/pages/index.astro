---
import AppLayout from '../layouts/AppLayout.astro';
import { calendar } from '../data/site.js';

const _base = import.meta.env.BASE_URL || '/';
const b = _base.endsWith('/') ? _base : _base + '/';

// The cover is one viewport tall and never scrolls, so everything that used to
// sit below the fold now lives on its own page. This list is the whole site.
const index = [
  { n: '01', label: 'Catalogue',   href: `${b}portfolio/`,   note: 'Works & scores' },
  { n: '02', label: 'Visual Art',  href: `${b}visual-art/`,  note: 'Installation, video, stage' },
  { n: '03', label: 'Calendar',    href: `${b}calendar/`,    note: 'Upcoming dates' },
  { n: '04', label: 'Recordings',  href: `${b}recordings/`,  note: 'Audio & video' },
  { n: '05', label: 'Discography', href: `${b}discography/`, note: 'Albums & releases' },
  { n: '06', label: 'Software',    href: `${b}software/`,    note: 'Apps & platforms' },
  { n: '07', label: 'Press',       href: `${b}press/`,       note: 'Selected coverage' },
  { n: '08', label: 'Biography',   href: `${b}bio/`,         note: 'Three lengths' },
  { n: '09', label: 'Resume',      href: `${b}resume/`,      note: 'Full curriculum vitae' },
];

const today = new Date().toISOString().split('T')[0];
const next = calendar.filter(e => e.date >= today)[0];

const heroImg = 'https://creartbox-media-cdn.b-cdn.net/webimg/projects_photos/20251212/comp/_MG_0161.jpg';
---
<AppLayout
  fullscreen
  title="Guillermo Laporta · Flutist, Composer, Director"
  description="Guillermo Laporta is a flutist, composer and cultural producer based between New York City and Asturias, Spain. Founder of CreArtBox and Festival ADAR."
>
  <main class="cover">
    <div class="cover-bg">
      <img src={heroImg} alt="" loading="eager" fetchpriority="high" />
      <div class="cover-veil"></div>
    </div>

    <div class="cover-inner">
      <div class="cover-id">
        <div class="cover-eyebrow">Flutist · Composer · Director</div>
        <h1 class="cover-name">Guillermo Laporta</h1>
        <p class="cover-statement">
          I play the flute, write music, and run two organisations: CreArtBox in New York
          and Festival ADAR in rural Asturias. Projects tend to start with something
          practical: a venue, a programme, a deadline. The music follows from there.
        </p>
        <div class="cover-meta">
          <span>New York · Asturias, Spain</span>
          {next && (
            <a class="cover-next" href={`${b}calendar/`}>
              Next · {next.displayDate} {next.year} · {next.title}
            </a>
          )}
        </div>
      </div>

      <nav class="cover-index" aria-label="Sections">
        <ul>
          {index.map((s) => (
            <li>
              <a href={s.href}>
                <span class="ix-n">{s.n}</span>
                <span class="ix-label">{s.label}</span>
                <span class="ix-note">{s.note}</span>
                <span class="ix-arr" aria-hidden="true">&#8594;</span>
              </a>
            </li>
          ))}
        </ul>
        <a class="cover-contact" href="mailto:guillermo@creartbox.nyc">guillermo@creartbox.nyc</a>
      </nav>
    </div>
  </main>

  <style>
    .cover{position:relative;overflow:hidden;display:flex;background:#0B0B0C}

    .cover-bg{position:absolute;inset:0}
    .cover-bg img{width:100%;height:100%;object-fit:cover;object-position:center 22%;display:block}
    /* Dark on the left so the statement holds contrast, lighter on the right so
       the photograph is still a photograph. */
    .cover-veil{
      position:absolute;inset:0;
      background:
        linear-gradient(to right,rgba(8,8,9,.92) 0%,rgba(8,8,9,.72) 46%,rgba(8,8,9,.44) 100%),
        linear-gradient(to top,rgba(8,8,9,.55) 0%,rgba(8,8,9,0) 45%);
    }

    .cover-inner{
      position:relative;z-index:2;width:100%;max-width:1480px;margin:0 auto;
      padding:48px 56px;
      display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,36%);
      gap:64px;align-items:center;
    }

    /* identity */
    .cover-eyebrow{
      font-family:var(--mono);font-size:10.5px;letter-spacing:.2em;
      text-transform:uppercase;color:rgba(255,255,255,.5);margin-bottom:18px;
    }
    .cover-name{
      font-family:var(--serif);font-weight:300;
      font-size:clamp(44px,6vw,88px);line-height:.96;letter-spacing:-.03em;color:#fff;
    }
    .cover-statement{
      margin-top:26px;max-width:46ch;
      font-size:clamp(15px,1.1vw,17px);line-height:1.62;color:rgba(255,255,255,.78);
    }
    .cover-meta{
      margin-top:28px;display:flex;flex-wrap:wrap;align-items:center;gap:10px 20px;
      font-family:var(--mono);font-size:10px;letter-spacing:.14em;
      text-transform:uppercase;color:rgba(255,255,255,.45);
    }
    .cover-next{
      color:rgba(255,255,255,.74);border-bottom:1px solid rgba(255,255,255,.26);
      padding-bottom:3px;transition:color .18s,border-color .18s;
    }
    .cover-next:hover{color:#fff;border-color:var(--accent)}

    /* index of pages */
    .cover-index ul{list-style:none;display:grid;gap:0;border-top:1px solid rgba(255,255,255,.14)}
    .cover-index li{border-bottom:1px solid rgba(255,255,255,.14)}
    .cover-index a{
      display:grid;grid-template-columns:auto 1fr auto;align-items:baseline;
      gap:4px 14px;padding:11px 2px;color:rgba(255,255,255,.9);
      transition:background .18s,padding .18s;
    }
    .cover-index a:hover{background:rgba(255,255,255,.07);padding-left:10px;padding-right:10px}
    .ix-n{font-family:var(--mono);font-size:9.5px;letter-spacing:.14em;color:rgba(255,255,255,.36)}
    .ix-label{font-family:var(--serif);font-size:19px;font-weight:400;letter-spacing:-.01em;line-height:1.1}
    .ix-note{grid-column:2;font-size:11.5px;color:rgba(255,255,255,.45);line-height:1.3}
    .ix-arr{
      grid-row:1 / span 2;grid-column:3;align-self:center;
      font-size:13px;color:rgba(255,255,255,.3);transition:color .18s,transform .18s;
    }
    .cover-index a:hover .ix-arr{color:var(--accent);transform:translateX(3px)}

    .cover-contact{
      display:inline-block;margin-top:22px;
      font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;
      color:rgba(255,255,255,.52);border-bottom:1px solid rgba(255,255,255,.2);padding-bottom:3px;
      transition:color .18s,border-color .18s;
    }
    .cover-contact:hover{color:#fff;border-color:var(--accent)}

    /* tablet */
    @media(max-width:1100px){
      .cover-inner{grid-template-columns:1fr;gap:36px;align-content:center;padding:40px}
      .cover-statement{max-width:60ch}
      .cover-index ul{grid-template-columns:repeat(2,1fr);column-gap:28px}
    }

    /* phone */
    @media(max-width:720px){
      .cover-inner{padding:24px 20px 14px;gap:22px;align-content:center}
      .cover-eyebrow{margin-bottom:12px;font-size:9.5px}
      .cover-name{font-size:clamp(34px,11vw,46px)}
      .cover-statement{margin-top:16px;font-size:14px;line-height:1.55}
      .cover-meta{margin-top:16px;gap:6px 14px;font-size:9px}
      .cover-index ul{grid-template-columns:repeat(2,1fr);column-gap:18px}
      .cover-index a{grid-template-columns:auto 1fr;gap:8px;padding:8px 0}
      .ix-label{font-size:15px}
      .ix-note{display:none}
      .ix-arr{display:none}
      .cover-contact{margin-top:14px;font-size:9px}
    }

    /* Short phones: the statement goes before the index does. */
    @media(max-width:720px) and (max-height:720px){
      .cover-statement{display:none}
    }
  </style>
</AppLayout>
