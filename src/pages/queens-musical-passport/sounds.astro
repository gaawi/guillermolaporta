---
import AppLayout from '../../layouts/AppLayout.astro';
import { asset } from '../../lib/asset.js';
import { grant } from '../../data/grant.js';

const _base = import.meta.env.BASE_URL || '/';
const b = _base.endsWith('/') ? _base : _base + '/';

// The Sound Hunt: after the concert (never during it), children record the
// sounds of their neighbourhood and send them to Guillermo, who writes new
// music from them. This is the field-recording part of the original project.
//
// A grown-up accepts the terms first (the gate below). They are versioned:
// bump TERMS_VERSION when the wording changes and everyone is asked again.
// They were drafted for Guillermo, not by a lawyer.
//
// Recordings stay on the phone (IndexedDB, so closing the page loses nothing)
// until the grown-up presses Send. Each one is then posted as an ordinary form
// to FormSubmit, which emails it to Guillermo as an attachment, one email per
// sound, with the neighborhood, the sound and the terms acceptance. This
// website itself stores nothing. FormSubmit needs a one-time activation: the
// first send triggers an email to CONTACT with an "Activate" button.
//
// If the microphone cannot be used, the page says why (Brave on iPhone refuses
// websites the microphone without asking) and offers Guillermo's fallback:
// record with the phone's own app and email it to him.
//
// The icons are drawn here, in the poster's colours, in a flat style. They are
// not Flaticon's: those need a licence or a visible attribution.
const contact = 'guillermolaporta@gmail.com';
const MAX_SECONDS = 15;
const TERMS_VERSION = '2';

const N = '#1F2A3C', Y = '#F2C230', R = '#E2563E', B = '#3866D6', G = '#2E9E6B';
const LB = '#BFD3FF', OR = '#F28C38', CR = '#FFF6DD', TAN = '#F2B880', PU = '#A98BEA';
const st = `stroke="${N}" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"`;
const drop = (x, y) => `<path d="M${x} ${y} C${x - 4} ${y + 6} ${x - 4} ${y + 10} ${x} ${y + 10} C${x + 4} ${y + 10} ${x + 4} ${y + 6} ${x} ${y} Z" fill="${B}" ${st}/>`;

const ICONS = {
  subway: `<path d="M8 57 H56" ${st} fill="none"/><path d="M21 49 L15 57 M43 49 L49 57" ${st} fill="none"/>
    <rect x="13" y="7" width="38" height="42" rx="10" fill="${B}" ${st}/>
    <rect x="19" y="13" width="26" height="15" rx="4" fill="${LB}" ${st}/>
    <rect x="14.5" y="32" width="35" height="5" fill="${R}"/>
    <circle cx="22" cy="43" r="3.5" fill="${Y}" ${st}/><circle cx="42" cy="43" r="3.5" fill="${Y}" ${st}/>`,
  birds: `<path d="M27 50 V57 M35 50 V57" ${st} fill="none"/>
    <path d="M12 38 C12 25 23 18 35 20 C46 22 50 33 46 42 C42 51 20 53 12 38 Z" fill="${Y}" ${st}/>
    <path d="M20 35 C27 30 34 32 36 39 C29 42 23 42 20 35 Z" fill="${OR}" ${st}/>
    <circle cx="44" cy="21" r="10" fill="${Y}" ${st}/>
    <path d="M53 19 L61 22.5 L53 26 Z" fill="${OR}" ${st}/>
    <circle cx="46" cy="19" r="2.2" fill="${N}"/>`,
  voices: `<rect x="5" y="8" width="34" height="24" rx="8" fill="${R}" ${st}/>
    <path d="M13 32 L11 41 L22 32" fill="${R}" ${st}/>
    <circle cx="14" cy="20" r="2.6" fill="#fff"/><circle cx="22" cy="20" r="2.6" fill="#fff"/><circle cx="30" cy="20" r="2.6" fill="#fff"/>
    <rect x="25" y="26" width="34" height="24" rx="8" fill="${B}" ${st}/>
    <path d="M50 50 L53 58 L42 50" fill="${B}" ${st}/>
    <circle cx="34" cy="38" r="2.6" fill="#fff"/><circle cx="42" cy="38" r="2.6" fill="#fff"/><circle cx="50" cy="38" r="2.6" fill="#fff"/>`,
  music: `<circle cx="32" cy="32" r="26" fill="${G}" ${st}/>
    <path d="M25 43 V20 L45 15 V38" fill="none" stroke="#fff" stroke-width="4" stroke-linejoin="round"/>
    <path d="M25 26 L45 21" stroke="#fff" stroke-width="4"/>
    <ellipse cx="20" cy="43" rx="6" ry="4.6" fill="${Y}" ${st}/><ellipse cx="40" cy="38" rx="6" ry="4.6" fill="${Y}" ${st}/>`,
  horns: `<path d="M51 13 q4 4 0 8" fill="none" ${st}/><path d="M56 9 q8 8 0 16" fill="none" ${st}/>
    <path d="M6 42 V33 L15 22 H37 L46 32 H54 a5 5 0 0 1 5 5 V42 Z" fill="${R}" ${st}/>
    <path d="M18 26 H35 L40 32 H14 Z" fill="${LB}" ${st}/>
    <circle cx="17" cy="43" r="6.5" fill="${N}"/><circle cx="17" cy="43" r="2.4" fill="#fff"/>
    <circle cx="47" cy="43" r="6.5" fill="${N}"/><circle cx="47" cy="43" r="2.4" fill="#fff"/>
    <circle cx="56" cy="37" r="1.8" fill="${Y}"/>`,
  planes: `<path d="M28 30 L40 12 H47 L41 30 Z" fill="${B}" ${st}/>
    <path d="M9 30 L5 18 H12 L19 30 Z" fill="${R}" ${st}/>
    <path d="M5 37 C5 32 10 30 16 30 H50 C57 30 61 33 61 37 C61 41 57 44 50 44 H16 C10 44 5 41 5 37 Z" fill="#fff" ${st}/>
    <path d="M28 44 L40 58 H47 L41 44 Z" fill="${B}" ${st}/>
    <circle cx="22" cy="37" r="2.3" fill="${B}"/><circle cx="29" cy="37" r="2.3" fill="${B}"/><circle cx="36" cy="37" r="2.3" fill="${B}"/>
    <path d="M53 33 C57 34 58 38 55 40" fill="${LB}" ${st}/>`,
  rain: `<path d="M17 35 C8 35 6 24 14 22 C14 13 25 9 31 15 C35 7 49 9 49 20 C57 20 59 35 49 35 Z" fill="#EAF0FB" ${st}/>
    ${drop(18, 41)}${drop(32, 46)}${drop(46, 41)}`,
  dogs: `<path d="M17 21 C8 21 5 39 12 44 C17 42 19 31 19 25 Z" fill="${N}"/>
    <path d="M47 21 C56 21 59 39 52 44 C47 42 45 31 45 25 Z" fill="${N}"/>
    <ellipse cx="32" cy="35" rx="17" ry="17" fill="${TAN}" ${st}/>
    <circle cx="25" cy="31" r="2.6" fill="${N}"/><circle cx="39" cy="31" r="2.6" fill="${N}"/>
    <ellipse cx="32" cy="42" rx="8.5" ry="6.5" fill="${CR}" ${st}/>
    <ellipse cx="32" cy="38.5" rx="3.6" ry="2.6" fill="${N}"/>
    <path d="M29 46 Q32 53 35 46 Z" fill="${R}"/>`,
  steps: `<path d="M13 30 C9 20 13 7 21 7 C29 7 31 20 27 30 Z" fill="${R}" ${st}/>
    <ellipse cx="20" cy="39" rx="6.5" ry="6" fill="${R}" ${st}/>
    <path d="M37 42 C33 32 37 19 45 19 C53 19 55 32 51 42 Z" fill="${B}" ${st}/>
    <ellipse cx="44" cy="51" rx="6.5" ry="6" fill="${B}" ${st}/>`,
  wind: `<path d="M6 21 H37 C45 21 45 9 37 9 C32 9 31 14 32 16" fill="none" stroke="${B}" stroke-width="4.5" stroke-linecap="round"/>
    <path d="M6 33 H49 C58 33 58 46 49 46 C44 46 43 41 44 39" fill="none" stroke="${B}" stroke-width="4.5" stroke-linecap="round"/>
    <path d="M6 45 H27" fill="none" stroke="${B}" stroke-width="4.5" stroke-linecap="round"/>
    <path d="M44 9 C48 2 58 3 59 3 C59 12 51 16 44 9 Z" fill="${G}" ${st}/>
    <path d="M18 52 C22 46 30 47 31 47 C30 55 23 58 18 52 Z" fill="${G}" ${st}/>`,
  build: `<path d="M9 22 l5 5 -5 5 5 5" fill="none" ${st}/><path d="M55 22 l-5 5 5 5 -5 5" fill="none" ${st}/>
    <rect x="15" y="50" width="34" height="7" rx="2" fill="${OR}" ${st}/>
    <path d="M23 50 L32 9 L41 50 Z" fill="${OR}" ${st}/>
    <path d="M27.4 31 H36.6" stroke="#fff" stroke-width="4.5"/><path d="M25.6 40 H38.4" stroke="#fff" stroke-width="4.5"/>`,
  mystery: `<circle cx="32" cy="33" r="25" fill="${PU}" ${st}/>
    <path d="M24 27 C24 16 40 16 40 27 C40 33 32 34 32 41" fill="none" stroke="#fff" stroke-width="5.5" stroke-linecap="round"/>
    <circle cx="32" cy="49" r="3.4" fill="#fff"/>
    <path d="M53 5 l2.2 5 5 2.2 -5 2.2 -2.2 5 -2.2 -5 -5 -2.2 5 -2.2 z" fill="${Y}" ${st}/>`,
};

const sounds = [
  ['subway', 'Subway', 'Metro'], ['birds', 'Birds', 'Pájaros'], ['voices', 'Voices', 'Voces'],
  ['music', 'Music', 'Música'], ['horns', 'Car horns', 'Bocinas'], ['planes', 'Airplanes', 'Aviones'],
  ['rain', 'Rain', 'Lluvia'], ['dogs', 'Dogs', 'Perros'], ['steps', 'Footsteps', 'Pasos'],
  ['wind', 'Wind', 'Viento'], ['build', 'Construction', 'Obras'], ['mystery', 'Mystery sound', 'Sonido misterioso'],
];

const hoods = [
  'Long Island City', 'Astoria', 'Sunnyside', 'Woodside', 'Jackson Heights',
  'Elmhurst', 'Corona', 'Flushing', 'Jamaica', 'Other · Otro',
];

// The terms. English first, Spanish second, same numbering.
const terms = [
  ['Stay together, stay safe.',
   'A grown-up stays with the child the whole time. Record only in safe public places; watch for traffic, trains and crowds, and never go somewhere unsafe to get a sound.',
   'Quédense juntos, con seguridad.',
   'Un adulto acompaña al niño en todo momento. Graben solo en lugares públicos seguros; atención al tráfico, los trenes y las multitudes, y nunca vayan a un sitio peligroso para conseguir un sonido.'],
  ['Record sounds, not people.',
   'Do not record anyone’s private conversation, do not say anyone’s name, and do not record inside homes, shops or other private places without permission. Follow the rules of wherever you are.',
   'Graben sonidos, no personas.',
   'No graben conversaciones privadas, no digan el nombre de nadie y no graben dentro de casas, tiendas u otros lugares privados sin permiso. Respeten las normas de cada lugar.'],
  ['What happens to your recordings.',
   `Recordings stay on your phone until you press Send. Then each one is emailed to Guillermo Laporta (${contact}) through FormSubmit, a form-delivery service, together with the neighborhood and the kind of sound you chose. This website does not keep any copy, and no name, email address or other personal information is asked for or sent.`,
   'Qué pasa con sus grabaciones.',
   `Las grabaciones se quedan en su teléfono hasta que pulsen Enviar. Entonces cada una se envía por correo a Guillermo Laporta (${contact}) a través de FormSubmit, un servicio de envío de formularios, junto con el barrio y el tipo de sonido elegidos. Esta web no guarda ninguna copia, y no se pide ni se envía ningún nombre, correo ni otro dato personal.`],
  ['Permission to use what you send.',
   `By sending recordings you confirm that you or your child made them, and you give Guillermo Laporta free, non-exclusive, worldwide and permanent permission to use, edit and include them, in whole or in part, in musical works and in the performances, recordings and promotion of ${grant.project}, without payment or credit. To have a sound deleted before it is used, write to ${contact}.`,
   'Permiso para usar lo que envíen.',
   `Al enviar grabaciones confirman que las hicieron ustedes o su hijo o hija, y dan a Guillermo Laporta permiso gratuito, no exclusivo, mundial y permanente para usarlas, editarlas e incluirlas, enteras o en parte, en obras musicales y en las actuaciones, grabaciones y promoción de El Pasaporte Musical de Queens, sin pago ni mención. Para que se borre un sonido antes de usarlo, escriban a ${contact}.`],
  ['The microphone.',
   'The page uses your phone’s microphone only while the record button is on. You can turn that permission off at any time in your phone’s settings.',
   'El micrófono.',
   'La página usa el micrófono solo mientras el botón de grabar está encendido. Pueden retirar ese permiso cuando quieran en los ajustes del teléfono.'],
  ['At your own risk.',
   'You use this page and take part in the Sound Hunt at your own risk. To the extent permitted by law, Guillermo Laporta and the organizations that support the project are not responsible for any injury, loss or damage connected with it.',
   'Bajo su responsabilidad.',
   'Usan esta página y participan en la Caza de Sonidos bajo su propia responsabilidad. En la medida en que lo permita la ley, ni Guillermo Laporta ni las organizaciones que apoyan el proyecto son responsables de lesiones, pérdidas o daños relacionados con ella.'],
];

const MIC = `<svg viewBox="0 0 64 64" aria-hidden="true"><rect x="23" y="7" width="18" height="31" rx="9" fill="#fff"/><path d="M15 30 C15 44 49 44 49 30" fill="none" stroke="#fff" stroke-width="4.5" stroke-linecap="round"/><path d="M32 43 V53 M23 55 H41" stroke="#fff" stroke-width="4.5" stroke-linecap="round"/></svg>`;
const W = 'fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"';
const GATE_ICONS = {
  adult: `<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="5" r="2.6" ${W}/><path d="M8 8 V15 M8 15 L5 21 M8 15 L11 21 M4 11 H14" ${W}/><circle cx="17" cy="11" r="2" ${W}/><path d="M17 13.5 V17.5 M17 17.5 L15.2 21 M17 17.5 L18.8 21 M14 15 H20" ${W}/></svg>`,
  ear: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 9 a5 5 0 0 1 10 0 c0 3 -3 4 -3 7 a3 3 0 0 1 -6 0" ${W}/><path d="M10 9 a2 2 0 0 1 4 0 c0 1.5 -2 2 -2 3" ${W}/></svg>`,
  note: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18 V5 L19 3 V16" ${W}/><circle cx="6.5" cy="18" r="2.5" ${W}/><circle cx="16.5" cy="16" r="2.5" ${W}/></svg>`,
};
const PLANE = `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11 L21 3 L14 21 L11 13 Z"/></svg>`;
---
<AppLayout
  bare
  title={`Sound Hunt · ${grant.project}`}
  description="After the concert, children record the sounds of their Queens neighborhood and send them to composer Guillermo Laporta, who turns them into new music."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Rubik:ital,wght@0,500;0,700;0,800;0,900;1,500&display=swap" />

  <main class="sh" id="sh" data-contact={contact} data-max={MAX_SECONDS} data-terms={TERMS_VERSION}
        data-project={grant.project} data-icons={JSON.stringify(ICONS)} data-sounds={JSON.stringify(sounds)}>

    <!-- ── the ticket ──────────────────────────────────────── -->
    <header class="sh-ticket">
      <div class="sh-ticket-bar"><span>♪ Sound hunt</span><span>Caza de sonidos</span></div>
      <div class="sh-art">
        <img src={asset('images/events/sound-hunt-7-train.webp')} width="1100" height="978"
             alt="Mozart playing the violin in the window of a 7 train, between Queens buildings, with music notes and a plane overhead" />
      </div>
      <div class="sh-ticket-body">
        <h1 class="sh-project">{grant.project}</h1>
        <p class="sh-project-es">El Pasaporte Musical de Queens</p>
        <div class="sh-stickers">
          <div class="sh-sticker sh-sticker-red">For kids<i>Para niños</i></div>
          <div class="sh-sticker sh-sticker-blue">With a grown-up<i>Con un adulto</i></div>
        </div>
        <h2 class="sh-title">Record your neighborhood!</h2>
        <p class="sh-title-es">¡Graba tu barrio!</p>
        <p class="sh-lead">
          Go outside and find the sounds where you live. Record them and send them to
          Guillermo: he will turn them into <b>new music</b>!
        </p>
        <p class="sh-lead sh-es">
          Sal a buscar los sonidos de donde vives. Grábalos y envíaselos a Guillermo:
          ¡los convertirá en <b>música nueva</b>!
        </p>
      </div>
    </header>

    <!-- ── 1 · where ───────────────────────────────────────── -->
    <section class="sh-card">
      <div class="sh-step"><span>1</span> Where are you? <i>¿Dónde estás?</i></div>
      <div class="sh-hoods" role="radiogroup" aria-label="Neighborhood">
        {hoods.map((h, i) => (
          <button type="button" class={`sh-hood c${i % 4}`} role="radio" aria-checked="false" data-hood={h}>{h}</button>
        ))}
      </div>
    </section>

    <!-- ── 2 · what ────────────────────────────────────────── -->
    <section class="sh-card">
      <div class="sh-step"><span>2</span> What sound did you find? <i>¿Qué sonido encontraste?</i></div>
      <p class="sh-hint">Tap it, then record it · Tócalo y grábalo</p>
      <div class="sh-sounds">
        {sounds.map(([key, en, es]) => (
          <button type="button" class="sh-snd" data-snd={key}>
            <svg viewBox="0 0 64 64" aria-hidden="true" set:html={ICONS[key]}></svg>
            <b>{en}</b><i>{es}</i>
          </button>
        ))}
      </div>
    </section>

    <!-- ── 3 · my sound passport ───────────────────────────── -->
    <section class="sh-card" id="mine">
      <div class="sh-step"><span>3</span> My sound passport <i>Mi pasaporte de sonidos</i></div>
      <div class="sh-empty" id="empty">No sounds yet. Find one above! <i>Todavía no hay sonidos. ¡Busca uno arriba!</i></div>
      <ul class="sh-stamps" id="stamps"></ul>
    </section>

    <!-- ── 4 · send ────────────────────────────────────────── -->
    <section class="sh-card sh-send" id="send">
      <div class="sh-step"><span>4</span> Send them to Guillermo <i>Envíaselos a Guillermo</i></div>
      <p class="sh-to">
        One tap and your sounds go straight to Guillermo.
        <i>Un toque y tus sonidos le llegan directamente a Guillermo.</i>
      </p>
      <button type="button" class="sh-big sh-big-blue" id="send-btn">
        <span set:html={PLANE}></span><span id="send-label">Send my sounds · Enviar mis sonidos</span>
      </button>
      <div class="sh-progress" id="progress" hidden><span id="progress-bar"></span></div>
      <div class="sh-thanks" id="thanks" hidden>
        <b>Sent! Thank you!</b> Your sounds are on their way to becoming music.
        <i>¡Enviado! ¡Gracias! Tus sonidos van camino de convertirse en música.</i>
      </div>
      <div class="sh-fail" id="fail" hidden>
        <b>It didn’t go through. · No se pudo enviar.</b>
        <p>Check your connection and try again in a minute. Or save the sounds and email them to
          <i>Revisa la conexión y prueba otra vez. O guarda los sonidos y envíalos por correo a</i></p>
        <div class="sh-addr"><b>{contact}</b><button type="button" class="sh-copy">Copy · Copiar</button></div>
        <button type="button" class="sh-big sh-big-white" id="save-all">Save my sounds · Guardar mis sonidos</button>
      </div>
      <p class="sh-small">
        <button type="button" class="sh-linkbtn" id="reopen-terms">Terms for grown-ups · Condiciones para adultos</button>
      </p>
    </section>

    <footer class="sh-credit">
      <a href={grant.administratorUrl} target="_blank" rel="noopener">
        <img src={asset(grant.logo)} width={grant.logoWidth} height={grant.logoHeight}
             loading="lazy" alt={grant.administrator} />
      </a>
      <p>{grant.credit}</p>
      <a class="sh-about" href={`${b}queens-musical-passport/`}>About the project · Sobre el proyecto →</a>
    </footer>

    <!-- ── the recorder sheet ──────────────────────────────── -->
    <div class="sh-sheet-wrap" id="sheet" hidden>
      <div class="sh-backdrop" id="backdrop"></div>
      <div class="sh-sheet" role="dialog" aria-modal="true" aria-labelledby="rec-title">
        <button type="button" class="sh-close" id="close" aria-label="Close">✕</button>
        <svg class="sh-sheet-ico" id="rec-ico" viewBox="0 0 64 64" aria-hidden="true"></svg>
        <h2 class="sh-sheet-title" id="rec-title"></h2>
        <p class="sh-sheet-es" id="rec-title-es"></p>

        <div id="stage-rec">
          <p class="sh-sheet-hint">Hold the phone near the sound. Up to {MAX_SECONDS} seconds.<i>Acerca el teléfono al sonido. Hasta {MAX_SECONDS} segundos.</i></p>
          <p class="sh-askmic" id="askmic">
            When you tap, your phone will ask to use the microphone: tap <b>Allow</b>.
            <i>Al tocar, el teléfono pedirá usar el micrófono: toca <b>Permitir</b>.</i>
          </p>
          <div class="sh-meter" id="meter" aria-hidden="true">
            {Array.from({ length: 14 }, (_, i) => <span class={`m${i % 4}`}></span>)}
          </div>
          <div class="sh-recwrap">
            <svg class="sh-ring" viewBox="0 0 120 120" aria-hidden="true">
              <circle cx="60" cy="60" r="54" class="sh-ring-bg" />
              <circle cx="60" cy="60" r="54" class="sh-ring-fg" id="ring" />
            </svg>
            <button type="button" class="sh-rec" id="rec" aria-label="Record">
              <span id="rec-face" set:html={MIC}></span>
            </button>
          </div>
          <div class="sh-timer" id="timer">Tap to record · Toca para grabar</div>
        </div>

        <div id="stage-review" hidden>
          <button type="button" class="sh-big sh-big-green" id="play">▶ Listen · Escuchar</button>
          <div class="sh-review-btns">
            <button type="button" class="sh-big sh-big-red" id="keep">✓ Keep it! · ¡Me lo quedo!</button>
            <button type="button" class="sh-big sh-big-white" id="redo">↺ Try again · Otra vez</button>
          </div>
        </div>

        <!-- When the microphone cannot be used: why, how to fix it, and the email fallback. -->
        <div id="stage-nomic" class="sh-nomic" hidden>
          <p class="sh-nomic-why" id="nomic-why"></p>
          <p class="sh-nomic-fix" id="nomic-fix"></p>
          <button type="button" class="sh-big sh-big-white" id="copy-link">Copy this page’s link · Copiar el enlace</button>
          <div class="sh-plan-b">
            <b>Or send it by email · O envíalo por correo</b>
            <ol>
              <li>Record the sound with your phone’s own app (Voice Memos, Recorder or the camera). <i>Graba el sonido con la app del teléfono (Notas de voz, Grabadora o la cámara).</i></li>
              <li>Email it to Guillermo. <i>Envíaselo a Guillermo por correo.</i></li>
            </ol>
            <div class="sh-addr"><b>{contact}</b><button type="button" class="sh-copy">Copy · Copiar</button></div>
            <a class="sh-big sh-big-blue" id="mail-fallback" href="#">Write the email · Escribir el correo</a>
          </div>
          <button type="button" class="sh-big sh-big-white" id="retry-mic">↺ Try the microphone again · Probar otra vez</button>
        </div>
      </div>
    </div>

    <!-- ── the gate: terms for grown-ups, first ────────────── -->
    <div class="sh-gate" id="gate" hidden>
      <div class="sh-gate-card" role="dialog" aria-modal="true" aria-labelledby="gate-title">
        <div class="sh-ticket-bar"><span>♪ For grown-ups</span><span>Para adultos</span></div>
        <div class="sh-gate-body">
          <div class="sh-gate-project">{grant.project}</div>
          <h2 class="sh-gate-title" id="gate-title">Before you start <i>Antes de empezar</i></h2>

          <ul class="sh-sum">
            <li><span class="sh-sum-ico c0" set:html={GATE_ICONS.adult}></span>
              <div>A grown-up stays with the child, in safe public places.<i>Un adulto acompaña al niño, en lugares públicos seguros.</i></div></li>
            <li><span class="sh-sum-ico c1" set:html={GATE_ICONS.ear}></span>
              <div>Record sounds, not people’s conversations.<i>Graben sonidos, no conversaciones de la gente.</i></div></li>
            <li><span class="sh-sum-ico c2" set:html={GATE_ICONS.note}></span>
              <div>Guillermo may use the sounds you send in his music.<i>Guillermo puede usar en su música los sonidos que envíen.</i></div></li>
