  <script>
    const root = document.getElementById('sh');
    const CONTACT = root.dataset.contact;
    const MAX = Number(root.dataset.max);
    const TERMS = root.dataset.terms;
    const PROJECT = root.dataset.project;
    const ICONS = JSON.parse(root.dataset.icons);
    const SOUNDS = Object.fromEntries(JSON.parse(root.dataset.sounds).map(([k, en, es]) => [k, { en, es }]));
    const $ = (s) => document.querySelector(s);
    const $$ = (s) => [...document.querySelectorAll(s)];
    const store = {
      get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } },
      set(k, v) { try { localStorage.setItem(k, v); } catch (e) {} },
    };

    // ── the gate: nothing works until a grown-up has agreed ─
    const gate = $('#gate');
    function openGate() { gate.hidden = false; document.body.style.overflow = 'hidden'; gate.scrollTop = 0; }
    function closeGate() { gate.hidden = true; document.body.style.overflow = ''; }
    const agreeBtn = $('#agree');
    agreeBtn.addEventListener('click', () => {
      store.set('qmp-terms', `${TERMS}|${new Date().toISOString()}`);
      closeGate();
    });
    $('#reopen-terms').addEventListener('click', openGate);
    const termsRecord = () => (store.get('qmp-terms') || '').split('|');
    if (termsRecord()[0] !== TERMS) openGate();

    // ── storage: IndexedDB on this phone ────────────────────
    const DB = 'qmp-sound-hunt', OS = 'recs';
    let memory = [];
    function openDb() {
      return new Promise((res, rej) => {
        const r = indexedDB.open(DB, 1);
        r.onupgradeneeded = () => r.result.createObjectStore(OS, { keyPath: 'id' });
        r.onsuccess = () => res(r.result); r.onerror = () => rej(r.error);
      });
    }
    async function dbAll() {
      try { const db = await openDb();
        return await new Promise((res, rej) => { const q = db.transaction(OS).objectStore(OS).getAll();
          q.onsuccess = () => res(q.result || []); q.onerror = () => rej(q.error); });
      } catch (e) { return memory; }
    }
    async function dbPut(rec) {
      try { const db = await openDb();
        await new Promise((res, rej) => { const tx = db.transaction(OS, 'readwrite'); tx.objectStore(OS).put(rec);
          tx.oncomplete = res; tx.onerror = () => rej(tx.error); });
      } catch (e) { memory = memory.filter((r) => r.id !== rec.id).concat(rec); }
    }
    async function dbDel(id) {
      try { const db = await openDb();
        await new Promise((res, rej) => { const tx = db.transaction(OS, 'readwrite'); tx.objectStore(OS).delete(id);
          tx.oncomplete = res; tx.onerror = () => rej(tx.error); });
      } catch (e) { memory = memory.filter((r) => r.id !== id); }
    }

    // ── neighbourhood ───────────────────────────────────────
    let hood = store.get('qmp-hood') || '';
    $$('.sh-hood').forEach((b) => {
      b.setAttribute('aria-checked', String(b.dataset.hood === hood));
      b.addEventListener('click', () => {
        hood = b.dataset.hood;
        $$('.sh-hood').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
        store.set('qmp-hood', hood);
      });
    });

    // ── microphone: explain first, then ask, then say what went wrong ──
    // Brave on iPhone refuses websites the microphone without ever showing a
    // prompt; in-app browsers (WhatsApp, Instagram) may have no microphone at
    // all; a site blocked once is refused silently. Each gets its own message.
    const UA = navigator.userAgent;
    const isIOS = /iP(hone|ad|od)/.test(UA) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    const isAndroid = /Android/.test(UA);
    const inApp = /FBAN|FBAV|Instagram|Line\/|WhatsApp|Snapchat|TikTok|; wv\)/.test(UA);
    let isBrave = false;
    try { if (navigator.brave && navigator.brave.isBrave) navigator.brave.isBrave().then((v) => { isBrave = !!v; }); } catch (e) {}
    const canRecord = !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia && window.MediaRecorder);

    function fixFor(kind) {
      if (isBrave && isIOS) return [
        'Brave on iPhone doesn’t let websites use the microphone, and it doesn’t ask. Copy the link below and open this page in Safari.',
        'Brave en iPhone no deja a las webs usar el micrófono, y no lo pregunta. Copia el enlace de abajo y abre esta página en Safari.'];
      if (kind === 'unsupported') return inApp
        ? ['Open this page in Safari or Chrome: tap ··· or the share button and choose “Open in browser”.', 'Abre esta página en Safari o Chrome: toca ··· o compartir y elige «Abrir en el navegador».']
        : ['Open this page in Safari or Chrome.', 'Abre esta página en Safari o Chrome.'];
      if (kind === 'blocked') {
        if (isIOS) return ['On iPhone: in Safari, tap “aA” in the address bar › Website Settings › Microphone › Allow. In Chrome: Settings app › Chrome › Microphone on.',
                           'En iPhone: en Safari, toca «aA» en la barra de dirección › Ajustes del sitio web › Micrófono › Permitir. En Chrome: app Ajustes › Chrome › Micrófono activado.'];
        if (isAndroid) return ['On Android: tap the icon left of the address › Permissions › Microphone › Allow, then try again.',
                               'En Android: toca el icono a la izquierda de la dirección › Permisos › Micrófono › Permitir, y prueba otra vez.'];
        return ['Allow the microphone for this site in your browser’s settings, then try again.', 'Permite el micrófono para esta web en los ajustes del navegador y prueba otra vez.'];
      }
      if (kind === 'busy') return ['Close any call or app that is using the microphone, then try again.', 'Cierra cualquier llamada o app que esté usando el micrófono y prueba otra vez.'];
      if (kind === 'none') return ['This device does not seem to have a microphone.', 'Este aparato no parece tener micrófono.'];
      return ['Try again, or send the sound by email.', 'Prueba otra vez o envía el sonido por correo.'];
    }
    const WHY = {
      unsupported: ['This browser can’t use the microphone.', 'Este navegador no puede usar el micrófono.'],
      blocked: ['The microphone is blocked for this page.', 'El micrófono está bloqueado para esta página.'],
      busy: ['The microphone is busy.', 'El micrófono está ocupado.'],
      none: ['No microphone found.', 'No se encontró micrófono.'],
      other: ['The microphone didn’t start.', 'El micrófono no arrancó.'],
    };
    function showNoMic(kind, detail) {
      const [w, wEs] = WHY[kind] || WHY.other;
      const [f, fEs] = fixFor(kind);
      $('#nomic-why').innerHTML = `${w}<i>${wEs}</i>` + (detail ? `<i style="font-size:11px">(${detail})</i>` : '');
      $('#nomic-fix').innerHTML = `${f}<i>${fEs}</i>`;
      $('#copy-link').hidden = !(isBrave || inApp || kind === 'unsupported');
      const s = SOUNDS[current] || SOUNDS.mystery;
      const place = hood ? hood.replace(' · Otro', '') : '';
      const subject = `Sound Hunt: ${s.en}${place ? ' · ' + place : ''}`;
      const body = `Hi Guillermo! Here is my sound for ${PROJECT}.\n¡Hola Guillermo! Aquí está mi sonido para el Pasaporte Musical de Queens.\n\nSound · Sonido: ${s.en} · ${s.es}\nNeighborhood · Barrio: ${place || '—'}\n\n(Attach your recording · Adjunta tu grabación)\n`;
      $('#mail-fallback').href = `mailto:${CONTACT}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      $('#stage-rec').hidden = true; $('#stage-review').hidden = true; $('#stage-nomic').hidden = false;
    }
    async function micState() {
      try { const p = await navigator.permissions.query({ name: 'microphone' }); return p.state; } catch (e) { return 'unknown'; }
    }

    // ── recorder ────────────────────────────────────────────
    const TYPES = ['audio/mp4', 'audio/webm;codecs=opus', 'audio/webm', 'audio/ogg;codecs=opus'];
    let current = null, stream = null, recorder = null, chunks = [], meterCtx = null, raf = 0, stopT = 0, t0 = 0;
    let draft = null, draftUrl = null, player = null;
    const bars = $$('#meter span');
    const ring = $('#ring');
    const MIC_FACE = $('#rec-face').innerHTML;

    async function openSheet(key) {
      current = key;
      $('#rec-ico').innerHTML = ICONS[key];
      $('#rec-title').textContent = SOUNDS[key].en;
      $('#rec-title-es').textContent = SOUNDS[key].es;
      $('#stage-rec').hidden = false; $('#stage-review').hidden = true; $('#stage-nomic').hidden = true;
      resetRecUi();
      $('#sheet').hidden = false;
      document.body.style.overflow = 'hidden';
      if (!canRecord) { showNoMic('unsupported'); return; }
      const state = await micState();
      $('#askmic').hidden = state === 'granted';
      if (state === 'denied') showNoMic('blocked');
    }
    function closeSheet() {
      stopAll(true);
      $('#sheet').hidden = true;
      document.body.style.overflow = '';
      dropDraft();
    }
    function resetRecUi() {
      $('#rec').classList.remove('on');
      $('#rec-face').innerHTML = MIC_FACE;
      $('#timer').textContent = 'Tap to record · Toca para grabar';
      ring.style.strokeDashoffset = '339.3';
      bars.forEach((b) => { b.style.height = '6px'; });
    }

    async function startRec() {
      try {
        stream = await navigator.mediaDevices.getUserMedia({
          audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false },
        });
      } catch (e) {
        const n = (e && e.name) || 'Error';
        const kind = /NotAllowed|PermissionDenied|Security/.test(n) ? 'blocked'
                   : /NotFound|DevicesNotFound/.test(n) ? 'none'
                   : /NotReadable|TrackStart|Abort/.test(n) ? 'busy' : 'other';
        showNoMic(kind, n);
        return;
      }
      $('#askmic').hidden = true;
      const type = TYPES.find((t) => window.MediaRecorder.isTypeSupported && MediaRecorder.isTypeSupported(t));
      try { recorder = new MediaRecorder(stream, type ? { mimeType: type } : undefined); }
      catch (e) { recorder = new MediaRecorder(stream); }
      chunks = [];
      recorder.ondataavailable = (e) => { if (e.data && e.data.size) chunks.push(e.data); };
      recorder.onstop = finished;
      recorder.start(250);
      t0 = performance.now();
      try {
        const AC = window.AudioContext || window.webkitAudioContext;
        meterCtx = new AC();
        const src = meterCtx.createMediaStreamSource(stream);
        const an = meterCtx.createAnalyser(); an.fftSize = 64; src.connect(an);
        const data = new Uint8Array(an.frequencyBinCount);
        const tick = () => {
          an.getByteFrequencyData(data);
          bars.forEach((b, i) => { const v = data[Math.min(data.length - 1, i + 1)] / 255; b.style.height = `${6 + v * 50}px`; });
          paint(); raf = requestAnimationFrame(tick);
        };
        tick();
      } catch (e) { const tick = () => { paint(); raf = requestAnimationFrame(tick); }; tick(); }
      $('#rec').classList.add('on');
      $('#rec-face').innerHTML = '<span class="stop"></span>';
      stopT = setTimeout(stopRec, MAX * 1000);
    }
    function paint() {
      const s = Math.min(MAX, (performance.now() - t0) / 1000);
      ring.style.strokeDashoffset = String(339.3 * (1 - s / MAX));
      $('#timer').textContent = `● ${Math.ceil(MAX - s)}s · Tap to stop · Toca para parar`;
    }
    function stopAll(discard) {
      clearTimeout(stopT); cancelAnimationFrame(raf);
      if (recorder && recorder.state !== 'inactive') { if (discard) recorder.onstop = null; recorder.stop(); }
      if (stream) stream.getTracks().forEach((t) => t.stop());
      if (meterCtx) { try { meterCtx.close(); } catch (e) {} }
      stream = null; meterCtx = null;
    }
    function stopRec() { stopAll(false); }
    function finished() {
      const type = (recorder && recorder.mimeType) || (chunks[0] && chunks[0].type) || 'audio/webm';
      const dur = Math.min(MAX, (performance.now() - t0) / 1000);
      draft = { blob: new Blob(chunks, { type }), type, dur };
      draftUrl = URL.createObjectURL(draft.blob);
      $('#stage-rec').hidden = true; $('#stage-review').hidden = false;
      resetRecUi();
    }
    function dropDraft() {
      if (player) { player.pause(); player = null; }
      if (draftUrl) URL.revokeObjectURL(draftUrl);
      draft = null; draftUrl = null;
    }

    $('#rec').addEventListener('click', () => {
      if (!canRecord) { showNoMic('unsupported'); return; }
      if (recorder && recorder.state === 'recording') stopRec(); else startRec();
    });
    $('#retry-mic').addEventListener('click', () => {
      $('#stage-nomic').hidden = true; $('#stage-rec').hidden = false; resetRecUi();
      if (!canRecord) showNoMic('unsupported'); else startRec();
    });
    $('#copy-link').addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(location.href.split('#')[0]); $('#copy-link').textContent = '✓ Link copied · Enlace copiado'; }
      catch (e) { prompt('Link', location.href.split('#')[0]); }
    });
    $('#play').addEventListener('click', () => {
      if (!draftUrl) return;
      if (player) player.pause();
      player = new Audio(draftUrl); player.play().catch(() => {});
    });
    $('#redo').addEventListener('click', () => {
      dropDraft(); $('#stage-review').hidden = true; $('#stage-rec').hidden = false; resetRecUi();
    });
    $('#keep').addEventListener('click', async () => {
      if (!draft) return;
      const ext = draft.type.includes('mp4') ? 'm4a' : draft.type.includes('ogg') ? 'ogg' : 'webm';
      const place = (hood && !hood.startsWith('Other')) ? hood.toLowerCase().replace(/[^a-z]+/g, '-') : 'queens';
      const when = new Date().toISOString().slice(0, 16).replace(/[-:T]/g, '');
      await dbPut({
        id: `${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
        sound: current, hood: hood || '', blob: draft.blob, type: draft.type, dur: draft.dur, sent: false,
        name: `queens-musical-passport_${place}_${current}_${when}.${ext}`,
      });
      closeSheet(); render();
      $('#thanks').hidden = true; $('#fail').hidden = true;
      setTimeout(() => $('#mine').scrollIntoView({ behavior: 'smooth' }), 120);
    });
    $('#close').addEventListener('click', closeSheet);
    $('#backdrop').addEventListener('click', closeSheet);
    $$('.sh-snd').forEach((b) => b.addEventListener('click', () => openSheet(b.dataset.snd)));

    // ── my sound passport ───────────────────────────────────
    let listen = null;
    async function render() {
      const recs = (await dbAll()).sort((a, b) => a.id.localeCompare(b.id));
      $('#empty').hidden = recs.length > 0;
      const have = new Set(recs.map((r) => r.sound));
      $$('.sh-snd').forEach((b) => b.classList.toggle('has', have.has(b.dataset.snd)));
      const ul = $('#stamps'); ul.innerHTML = '';
      recs.forEach((r) => {
        const s = SOUNDS[r.sound] || SOUNDS.mystery;
        const li = document.createElement('li'); li.className = 'sh-stamp' + (r.sent ? ' sent' : '');
        li.innerHTML =
          (r.sent ? '<span class="sh-sent">Sent · Enviado</span>' : '') +
          `<svg viewBox="0 0 64 64" aria-hidden="true">${ICONS[r.sound] || ICONS.mystery}</svg>` +
          `<b>${s.en}</b>` +
          `<small>${r.hood ? r.hood.replace(' · Otro', '') + ' · ' : ''}${Math.max(1, Math.round(r.dur))}s</small>` +
          `<div class="sh-stamp-btns"><button type="button" class="play" aria-label="Listen">▶</button>` +
          `<button type="button" class="del" aria-label="Delete">✕</button></div>`;
        li.querySelector('.play').addEventListener('click', () => {
          if (listen) listen.pause();
          const u = URL.createObjectURL(r.blob); listen = new Audio(u);
          listen.onended = () => URL.revokeObjectURL(u); listen.play().catch(() => {});
        });
        li.querySelector('.del').addEventListener('click', async () => {
          if (!confirm('Delete this sound? · ¿Borrar este sonido?')) return;
          await dbDel(r.id); render();
        });
        ul.appendChild(li);
      });
      const pending = recs.filter((r) => !r.sent).length;
      $('#send-label').textContent = pending
        ? `Send ${pending} sound${pending === 1 ? '' : 's'} · Enviar ${pending} sonido${pending === 1 ? '' : 's'}`
        : 'Send my sounds · Enviar mis sonidos';
      return recs;
    }

    // ── send: a real form post, one email per sound ─────────
    // Each recording goes as an ordinary multipart form to FormSubmit, which
    // emails it to CONTACT as an attachment. A hidden iframe receives the
    // reply so the page never leaves. FormSubmit only redirects to _next, a
    // page on this site, once the email has gone out; if the frame shows
    // anything else (FormSubmit's own pages: activation pending, an error) it
    // is on another origin and cannot be read, and that counts as not sent.
    // The email also records which version of the terms the grown-
    // up accepted, and when: that is Guillermo's evidence of permission.
    const ENDPOINT = `https://formsubmit.co/${CONTACT}`;
    const NEXT = new URL('sent/', location.href.split(/[?#]/)[0]).href;
    function postOne(rec) {
      return new Promise((resolve) => {
        if (typeof DataTransfer === 'undefined') { resolve(false); return; }
        const name = `fs-${rec.id}`;
        const frame = document.createElement('iframe');
        frame.name = name; frame.hidden = true; frame.setAttribute('aria-hidden', 'true');
        document.body.appendChild(frame);
        const form = document.createElement('form');
        form.action = ENDPOINT; form.method = 'POST'; form.enctype = 'multipart/form-data'; form.target = name; form.hidden = true;
        const s = SOUNDS[rec.sound] || SOUNDS.mystery;
        const place = rec.hood ? rec.hood.replace(' · Otro', '') : 'Not given';
        const [ver, at] = termsRecord();
        const fields = {
          _subject: `Sound Hunt · ${s.en} · ${place}`,
          _captcha: 'false',
          _template: 'table',
          _next: NEXT,
          Project: PROJECT,
          Sound: `${s.en} · ${s.es}`,
          Neighborhood: place,
          'Length (s)': String(Math.max(1, Math.round(rec.dur))),
          'Recorded file': rec.name,
          'Terms accepted': `Version ${ver || '?'} on ${at || '?'}, by a grown-up who confirmed they are 18+ and the child's parent or guardian`,
        };
        for (const [k, v] of Object.entries(fields)) {
          const i = document.createElement('input'); i.type = 'hidden'; i.name = k; i.value = v; form.appendChild(i);
        }
        try {
          const dt = new DataTransfer();
          dt.items.add(new File([rec.blob], rec.name, { type: rec.type.split(';')[0] }));
          const fi = document.createElement('input'); fi.type = 'file'; fi.name = 'attachment'; fi.files = dt.files;
          form.appendChild(fi);
        } catch (e) { frame.remove(); resolve(false); return; }
        document.body.appendChild(form);
        let done = false;
        const finish = (ok) => { if (done) return; done = true; clearTimeout(timer); setTimeout(() => { form.remove(); frame.remove(); }, 1500); resolve(ok); };
        const timer = setTimeout(() => finish(false), 90000);
        frame.addEventListener('load', () => {
          let href;
          try { href = frame.contentWindow.location.href; } catch (e) { finish(false); return; }
          if (href === 'about:blank') return;          // the empty frame, before the post
          finish(href.startsWith(NEXT));
        });
        form.submit();
      });
    }

    let sending = false;
    $('#send-btn').addEventListener('click', async () => {
      if (sending) return;
      const recs = (await dbAll()).filter((r) => !r.sent).sort((a, b) => a.id.localeCompare(b.id));
      if (!recs.length) { $('#mine').scrollIntoView({ behavior: 'smooth' }); return; }
      if (termsRecord()[0] !== TERMS) { openGate(); return; }
      if (navigator.onLine === false) { $('#fail').hidden = false; return; }
      sending = true;
      const btn = $('#send-btn'); btn.disabled = true;
      $('#thanks').hidden = true; $('#fail').hidden = true; $('#progress').hidden = false;
      let ok = 0;
      for (let i = 0; i < recs.length; i++) {
        $('#send-label').textContent = `Sending ${i + 1} of ${recs.length}… · Enviando ${i + 1} de ${recs.length}…`;
        $('#progress-bar').style.width = `${(i / recs.length) * 100}%`;
        if (await postOne(recs[i])) { recs[i].sent = true; await dbPut(recs[i]); ok++; }
        else break;
      }
      $('#progress-bar').style.width = '100%';
      setTimeout(() => { $('#progress').hidden = true; }, 600);
      btn.disabled = false; sending = false;
      await render();
      if (ok === recs.length) $('#thanks').hidden = false; else $('#fail').hidden = false;
    });

    $('#save-all').addEventListener('click', async () => {
      const recs = await dbAll();
      for (const r of recs.filter((x) => !x.sent)) {
        const a = document.createElement('a'); a.href = URL.createObjectURL(r.blob); a.download = r.name;
        document.body.appendChild(a); a.click(); a.remove();
        await new Promise((ok) => setTimeout(ok, 400));
      }
    });
    $$('.sh-copy').forEach((btn) => btn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(CONTACT); btn.textContent = '✓ Copied · Copiado'; }
      catch (e) { prompt('Email', CONTACT); }
    }));

    render();
  </script>
</AppLayout>
