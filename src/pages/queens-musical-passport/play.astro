---
import AppLayout from '../../layouts/AppLayout.astro';
import { asset } from '../../lib/asset.js';
import { grant } from '../../data/grant.js';

const _base = import.meta.env.BASE_URL || '/';
const b = _base.endsWith('/') ? _base : _base + '/';

// The online companion to the printed Passport booklet. Every activity here
// mirrors a page of the booklet, with the same titles, the same ages and, for
// the three composers, the same fun facts, word for word.
//
// Nothing a child makes here is stored or sent anywhere by this site. A piece
// of music travels inside its own link (the part after #), and only reaches
// Guillermo if a grown-up chooses to send that link. No names, no voices, no
// accounts: this page is for children, and it collects nothing.
const contact = 'guillermo@creartbox.nyc';

const composers = [
  {
    key: 'mozart', name: 'Wolfgang Amadeus Mozart', life: '1756–1791 · Austria',
    work: 'String Quartet No. 19, “Dissonance”', workEs: 'Cuarteto n.º 19, «Disonancias»',
    fact: 'Mozart wrote his first music when he was 5 years old! Listen to the mysterious beginning: that’s why this quartet is nicknamed “Dissonance.”',
    factEs: '¡Mozart compuso su primera música con 5 años! Escucha el comienzo misterioso: por eso este cuarteto se llama «Disonancias».',
  },
  {
    key: 'ravel', name: 'Maurice Ravel', life: '1875–1937 · France · Francia',
    work: 'String Quartet in F major', workEs: 'Cuarteto de cuerda en fa mayor',
    fact: 'Ravel was a young composer, still in his twenties, when he wrote this quartet. In the second part, the musicians pluck the strings with their fingers. It’s called pizzicato!',
    factEs: 'Ravel era un compositor joven, de poco más de veinte años, cuando escribió este cuarteto. En la segunda parte, los músicos pellizcan las cuerdas con los dedos. ¡Se llama pizzicato!',
  },
  {
    key: 'price', name: 'Florence Price', life: '1887–1953 · United States · Estados Unidos',
    work: 'Five Folksongs in Counterpoint', workEs: 'Cinco canciones populares en contrapunto',
    fact: 'Florence Price was the first African American woman to have a symphony played by a major American orchestra. Here she uses old folk songs like “Clementine.” Do you know it?',
    factEs: 'Florence Price fue la primera mujer afroamericana en tener una sinfonía tocada por una gran orquesta de Estados Unidos. Aquí usa canciones populares antiguas como «Clementine». ¿La conoces?',
  },
];

const feelings = [
  ['😊', 'Happy', 'Alegre'], ['😢', 'Sad', 'Triste'], ['😌', 'Calm', 'Tranquila'],
  ['🤔', 'Mysterious', 'Misteriosa'], ['🐇', 'Fast', 'Rápida'], ['🐌', 'Slow', 'Lenta'],
  ['🔊', 'Loud', 'Fuerte'], ['🔈', 'Soft', 'Suave'],
];

const sounds = [
  ['subway', '🚇', 'Subway', 'Metro'], ['birds', '🐦', 'Birds', 'Pájaros'],
  ['voices', '🗣️', 'Voices', 'Voces'], ['music', '🎵', 'Music', 'Música'],
  ['horns', '🚗', 'Car horns', 'Bocinas'], ['planes', '✈️', 'Airplanes', 'Aviones'],
  ['rain', '🌧️', 'Rain', 'Lluvia'], ['dogs', '🐕', 'Dogs', 'Perros'],
  ['steps', '👣', 'Footsteps', 'Pasos'], ['wind', '🌬️', 'Wind', 'Viento'],
];

const lanes = [
  ['v1', 'Violin 1', 'Violín 1'], ['v2', 'Violin 2', 'Violín 2'],
  ['va', 'Viola', 'Viola'], ['vc', 'Cello', 'Violonchelo'],
];
const shapes = [
  [1, 'Short', 'Corto'], [2, 'Long', 'Largo'], [3, 'Wavy', 'Ondulado'], [4, 'Jumpy', 'Saltarín'],
];
const STEPS = 8;
---
<AppLayout
  title={`Play · ${grant.project}`}
  description="Interactive activities for children that go with the printed Queens Musical Passport: conduct, listen, find the sounds of your neighbourhood and compose your own music."
>
  <div class="qp" id="qp" data-contact={contact} data-steps={STEPS}>

    <header class="qp-head">
      <a class="qp-back" href={`${b}queens-musical-passport/`}>← {grant.project}</a>
      <div class="qp-eyebrow">Play · ¡A jugar!</div>
      <h1 class="qp-title">Keep playing at home</h1>
      <p class="qp-sub">Sigue jugando en casa</p>
      <p class="qp-lead">
        Everything here goes with your paper Passport. Turn your sound on!
        <span lang="es">Todo esto acompaña a tu Pasaporte de papel. ¡Sube el volumen!</span>
      </p>
      <nav class="qp-jump" aria-label="Activities">
        <a href="#conduct">🎼 Conduct</a>
        <a href="#listen">👂 Listen</a>
        <a href="#sounds">🏙️ Sounds</a>
        <a href="#compose">🎻 Compose</a>
        <a href="#draw">🖍️ Draw</a>
        <a href="#send">✉️ Send</a>
      </nav>
    </header>

    <div class="qp-banner" id="qp-banner" hidden>
      <b>🎻 Someone made this music for the Passport!</b>
      <span>¡Alguien hizo esta música para el Pasaporte! Press play · Pulsa play</span>
    </div>

    <!-- ── 1 · Conduct ──────────────────────────────────────── -->
    <section class="qp-card" id="conduct">
      <div class="qp-age">Ages 3+ · Desde 3 años</div>
      <h2 class="qp-h2">You conduct! <span>¡Tú diriges!</span></h2>
      <p class="qp-p">
        Press start, then lead the music with the buttons. This is <b>“Clementine”</b>, the old
        folk song Florence Price used in her quartet.
        <span lang="es">Pulsa empezar y dirige la música con los botones. Es «Clementine», la vieja canción que Florence Price usó en su cuarteto.</span>
      </p>

      <div class="qp-stage" aria-hidden="true">
        <div class="qp-baton" id="baton">🎼</div>
        <div class="qp-meter"><span id="cond-tempo">Medium</span> · <span id="cond-vol">Medium</span></div>
      </div>

      <div class="qp-buttons">
        <button class="qp-btn qp-btn-go" id="cond-start" type="button">▶ Start · Empezar</button>
        <button class="qp-btn" data-cond="loud"  type="button">🔊 Loud · Fuerte</button>
        <button class="qp-btn" data-cond="soft"  type="button">🔈 Soft · Suave</button>
        <button class="qp-btn" data-cond="fast"  type="button">🐇 Fast · Rápido</button>
        <button class="qp-btn" data-cond="slow"  type="button">🐌 Slow · Lento</button>
        <button class="qp-btn qp-btn-stop" data-cond="stop" type="button">✋ Stop · ¡Alto!</button>
      </div>
    </section>

    <!-- ── 2 · Listen ───────────────────────────────────────── -->
    <section class="qp-card" id="listen">
      <div class="qp-age">Ages 3+ · Desde 3 años</div>
      <h2 class="qp-h2">Listen! <span>¡Escucha!</span></h2>
      <p class="qp-p">
        How did each piece feel? Tap the faces.
        <span lang="es">¿Cómo se sintió cada pieza? Toca las caras.</span>
      </p>

      {composers.map((c) => (
        <div class="qp-comp" data-comp={c.key}>
          <div class="qp-comp-name">{c.name} <small>{c.life}</small></div>
          <div class="qp-comp-work">{c.work} · <i>{c.workEs}</i></div>
          <div class="qp-fact">
            <div class="qp-fact-k">Fun fact · Dato curioso</div>
            <p>{c.fact}</p>
            <p lang="es"><i>{c.factEs}</i></p>
          </div>
          <div class="qp-feel">
            {feelings.map(([emo, en, es], i) => (
              <button class="qp-chip" type="button" data-feel={i} aria-pressed="false">
                <span class="qp-emo">{emo}</span><b>{en}</b><i>{es}</i>
              </button>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- ── 3 · Sounds of my neighbourhood ───────────────────── -->
    <section class="qp-card" id="sounds">
      <div class="qp-age">Ages 4+ · Desde 4 años</div>
      <h2 class="qp-h2">Sounds of my neighborhood <span>Sonidos de mi barrio</span></h2>
      <p class="qp-p">
        Tap a sound to hear it. Keep the ones you hear where you live!
        <span lang="es">Toca un sonido para oírlo. ¡Quédate con los que oyes donde vives!</span>
      </p>
      <div class="qp-sounds">
        {sounds.map(([key, emo, en, es], i) => (
          <button class="qp-snd" type="button" data-snd={key} data-i={i} aria-pressed="false">
            <span class="qp-emo">{emo}</span><b>{en}</b><i>{es}</i>
          </button>
        ))}
      </div>
    </section>

    <!-- ── 4 · Compose ──────────────────────────────────────── -->
    <section class="qp-card" id="compose">
      <div class="qp-age">Ages 6+ · Desde 6 años</div>
      <h2 class="qp-h2">Compose your own music! <span>¡Compón tu propia música!</span></h2>
      <p class="qp-p">
        Pick a shape, then tap the boxes. Press play to hear your quartet.
        <span lang="es">Elige una figura y toca las casillas. Pulsa play para oír tu cuarteto.</span>
      </p>

      <div class="qp-brushes" role="radiogroup" aria-label="Shape">
        {shapes.map(([v, en, es]) => (
          <button class="qp-brush" type="button" role="radio" data-brush={v} aria-checked={v === 1 ? 'true' : 'false'}>
            <span class="qp-glyph" data-glyph={v}></span><b>{en}</b><i>{es}</i>
          </button>
        ))}
        <button class="qp-brush" type="button" role="radio" data-brush="0" aria-checked="false">
          <span class="qp-glyph qp-eraser">⌫</span><b>Erase</b><i>Borrar</i>
        </button>
      </div>

      <div class="qp-grid" id="grid">
        {lanes.map(([key, en, es], li) => (
          <div class={`qp-lane qp-lane-${key}`}>
            <div class="qp-lane-name"><b>{en}</b> <i>{es}</i></div>
            <div class="qp-cells">
              {Array.from({ length: STEPS }, (_, si) => (
                <button class="qp-cell" type="button" data-lane={li} data-step={si}
                        aria-label={`${en}, ${si + 1}`}></button>
              ))}
            </div>
          </div>
        ))}
        <div class="qp-time">Time · Tiempo →</div>
      </div>

      <div class="qp-buttons">
        <button class="qp-btn qp-btn-go" id="comp-play" type="button">▶ Play · Tocar</button>
        <button class="qp-btn" id="comp-clear" type="button">🧹 Start again · Empezar de nuevo</button>
      </div>
    </section>

    <!-- ── 5 · Draw ─────────────────────────────────────────── -->
    <section class="qp-card" id="draw">
      <div class="qp-age">Ages 3+ · Desde 3 años</div>
      <h2 class="qp-h2">Draw what you hear <span>Dibuja lo que oyes</span></h2>
      <p class="qp-p">
        Draw the music, or your favorite sound. Guillermo will use the drawings to write new music!
        <span lang="es">Dibuja la música o tu sonido favorito. ¡Guillermo usará los dibujos para escribir música nueva!</span>
      </p>
      <div class="qp-colors" role="radiogroup" aria-label="Colour">
        <button class="qp-color" type="button" data-color="#1F2A3C" aria-checked="true"  role="radio" aria-label="Black"></button>
        <button class="qp-color" type="button" data-color="#E2563E" aria-checked="false" role="radio" aria-label="Red"></button>
        <button class="qp-color" type="button" data-color="#F2C230" aria-checked="false" role="radio" aria-label="Yellow"></button>
        <button class="qp-color" type="button" data-color="#3866D6" aria-checked="false" role="radio" aria-label="Blue"></button>
        <button class="qp-color" type="button" data-color="#2E9E6B" aria-checked="false" role="radio" aria-label="Green"></button>
        <button class="qp-size" type="button" id="size" aria-label="Brush size">●</button>
      </div>
      <canvas class="qp-canvas" id="canvas" aria-label="Drawing area"></canvas>
      <div class="qp-buttons">
        <button class="qp-btn qp-btn-go" id="draw-save" type="button">💾 Save drawing · Guardar dibujo</button>
        <button class="qp-btn" id="draw-clear" type="button">🧹 Clear · Borrar</button>
      </div>
    </section>

    <!-- ── 6 · Send ─────────────────────────────────────────── -->
    <section class="qp-card qp-send" id="send">
      <h2 class="qp-h2">Send it to Guillermo <span>Envíaselo a Guillermo</span></h2>
      <p class="qp-p">
        Guillermo Laporta is writing a new piece from what children make for the Passport.
        Your music, your sounds and your feelings can be part of it!
        <span lang="es">Guillermo Laporta está escribiendo una pieza nueva con lo que hacen los niños para el Pasaporte. ¡Tu música, tus sonidos y lo que sentiste pueden formar parte!</span>
      </p>
      <div class="qp-summary" id="summary"></div>
      <div class="qp-buttons">
        <button class="qp-btn qp-btn-go" id="send-mail" type="button">✉️ Send my music · Enviar mi música</button>
        <button class="qp-btn" id="send-share" type="button">🔗 Share · Compartir</button>
      </div>
      <p class="qp-small">
        Drawings: save the drawing, then email it to
        <a href={`mailto:${contact}`}>{contact}</a>.
        <span lang="es">Dibujos: guarda el dibujo y envíalo por correo a esa dirección.</span>
      </p>

      <div class="qp-grownups">
        <b>For grown-ups · Para adultos</b>
        <p>
          Nothing made on this page is saved or sent anywhere unless you choose to send it. The
          music travels inside the link itself; there are no accounts and no recordings. Please
          don’t include children’s names or photos when you send something.
        </p>
        <p lang="es">
          Nada de lo que se hace en esta página se guarda ni se envía a ningún sitio, salvo que
          usted decida enviarlo. La música viaja dentro del propio enlace; no hay cuentas ni
          grabaciones. Por favor, no incluya nombres ni fotos de los niños al enviar algo.
        </p>
      </div>
    </section>

    <footer class="qp-credit">
      <a href={grant.administratorUrl} target="_blank" rel="noopener">
        <img src={asset(grant.logo)} width={grant.logoWidth} height={grant.logoHeight}
             loading="lazy" alt={grant.administrator} />
      </a>
      <p>{grant.credit}</p>
    </footer>
  </div>

  <style>
    .qp{
      --navy:#1F2A3C;--yellow:#F2C230;--red:#E2563E;--blue:#3866D6;--green:#2E9E6B;
      --paper:#FFFDF7;--soft:#F6F1E3;
      max-width:760px;margin:0 auto;padding:0 18px 80px;color:var(--navy);
    }
    .qp-head{padding:26px 0 18px}
    .qp-back{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
    .qp-eyebrow{margin-top:18px;display:inline-block;background:var(--yellow);color:var(--navy);
      font-family:var(--mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;padding:4px 9px;border-radius:999px}
    .qp-title{font-family:var(--serif);font-weight:700;font-size:clamp(34px,8vw,52px);line-height:1;letter-spacing:-.02em;margin-top:12px}
    .qp-sub{font-size:19px;font-style:italic;color:#5A6474;margin-top:4px}
    .qp-lead{margin-top:14px;font-size:16px;line-height:1.5}
    .qp-lead span,.qp-p span{display:block;font-style:italic;color:#5A6474;margin-top:3px}

    .qp-jump{display:flex;flex-wrap:wrap;gap:7px;margin-top:18px}
    .qp-jump a{background:#fff;border:2px solid var(--navy);border-radius:999px;padding:7px 12px;font-size:14px;font-weight:600}

    .qp-banner[hidden]{display:none}
    .qp-banner{background:var(--yellow);border-radius:16px;padding:14px 16px;margin:6px 0 4px;display:grid;gap:3px;font-size:15px}

    .qp-card{background:var(--paper);border:2.5px solid var(--navy);border-radius:22px;padding:20px 18px 22px;margin-top:20px;scroll-margin-top:84px}
    .qp-age{display:inline-block;border:2px solid var(--navy);border-radius:999px;padding:3px 10px;font-size:12px;font-weight:600}
    .qp-h2{font-family:var(--serif);font-weight:700;font-size:clamp(26px,6.4vw,34px);line-height:1.05;letter-spacing:-.015em;margin-top:12px}
    .qp-h2 span{display:block;font-family:var(--sans);font-size:17px;font-weight:400;font-style:italic;color:#5A6474;letter-spacing:0;margin-top:5px}
    .qp-p{font-size:16px;line-height:1.5;margin-top:10px}
    .qp-small{font-size:14px;line-height:1.5;margin-top:14px}
    .qp-small a{text-decoration:underline}

    .qp-buttons{display:flex;flex-wrap:wrap;gap:9px;margin-top:16px}
    .qp-btn{min-height:50px;padding:10px 16px;border-radius:14px;border:2.5px solid var(--navy);background:#fff;
      font-size:16px;font-weight:700;color:var(--navy);cursor:pointer;touch-action:manipulation}
    .qp-btn:active{transform:translateY(2px)}
    .qp-btn-go{background:var(--navy);color:#fff}
    .qp-btn-stop{background:var(--red);border-color:var(--red);color:#fff}
    .qp-btn.is-on{background:var(--yellow)}

    /* conduct */
    .qp-stage{margin-top:16px;height:150px;border-radius:18px;background:var(--soft);display:grid;place-items:center;align-content:center;gap:8px}
    .qp-baton{font-size:64px;line-height:1;transition:transform .12s ease}
    .qp-baton.pulse{transform:scale(1.25) rotate(-8deg)}
    .qp-meter{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase}

    /* listen */
    .qp-comp{margin-top:20px;padding-top:18px;border-top:2px dashed #C9C2B0}
    .qp-comp-name{font-family:var(--serif);font-weight:700;font-size:21px}
    .qp-comp-name small{display:block;font-family:var(--mono);font-size:11px;font-weight:400;color:#5A6474;margin-top:2px}
    .qp-comp-work{font-size:14px;margin-top:4px}
    .qp-fact{margin-top:10px;border:2px solid var(--navy);border-radius:14px;padding:11px 13px;background:#fff}
    .qp-fact-k{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#5A6474;margin-bottom:5px}
    .qp-fact p{font-size:15px;line-height:1.45;font-weight:600}
    .qp-fact p[lang=es]{font-weight:400;font-size:14px;margin-top:5px;color:#5A6474}

    .qp-feel{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:12px}
    .qp-chip,.qp-snd{display:grid;justify-items:center;gap:1px;padding:9px 3px 8px;border-radius:14px;border:2px solid #D8D1BF;
      background:#fff;cursor:pointer;touch-action:manipulation;color:var(--navy)}
    .qp-chip b,.qp-snd b{font-size:12.5px;line-height:1.15}
    .qp-chip i,.qp-snd i{font-size:11px;color:#5A6474}
    .qp-emo{font-size:28px;line-height:1.1}
    .qp-chip[aria-pressed=true],.qp-snd[aria-pressed=true]{border-color:var(--navy);background:var(--yellow);box-shadow:0 0 0 3px var(--navy) inset}

    /* sounds */
    .qp-sounds{display:grid;grid-template-columns:repeat(5,1fr);gap:7px;margin-top:14px}
    @media(max-width:520px){.qp-sounds{grid-template-columns:repeat(3,1fr)}}
    .qp-snd.playing .qp-emo{animation:wob .45s ease-in-out infinite alternate}
    @keyframes wob{from{transform:rotate(-10deg) scale(1.05)}to{transform:rotate(10deg) scale(1.15)}}

    /* compose */
    .qp-brushes{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-top:14px}
    .qp-brush{display:grid;justify-items:center;gap:1px;padding:8px 2px;border-radius:14px;border:2px solid #D8D1BF;background:#fff;
      cursor:pointer;color:var(--navy);touch-action:manipulation}
    .qp-brush b{font-size:12.5px}.qp-brush i{font-size:10.5px;color:#5A6474}
    .qp-brush[aria-checked=true]{border-color:var(--navy);background:var(--yellow);box-shadow:0 0 0 2px var(--navy) inset}
    .qp-glyph{height:24px;display:grid;place-items:center;font-size:20px}

    .qp-grid{margin-top:16px;display:grid;gap:10px}
    .qp-lane-name{font-size:14px;margin-bottom:4px}.qp-lane-name i{color:#5A6474}
    .qp-cells{display:grid;grid-template-columns:repeat(8,1fr);gap:5px}
    .qp-cell{aspect-ratio:1;min-height:38px;border-radius:10px;border:2px solid #C9C2B0;background:#fff;cursor:pointer;
      display:grid;place-items:center;padding:0;touch-action:manipulation}
    .qp-cell.now{outline:3px solid var(--navy);outline-offset:1px}
    .qp-cell.hit{transform:scale(1.12)}
    .qp-lane-v1 .qp-cell.on{background:#FCE3DE;border-color:var(--red);color:var(--red)}
    .qp-lane-v2 .qp-cell.on{background:#FDF3D2;border-color:#C99A0E;color:#B4880A}
    .qp-lane-va .qp-cell.on{background:#E1E8FA;border-color:var(--blue);color:var(--blue)}
    .qp-lane-vc .qp-cell.on{background:#DDF2E8;border-color:var(--green);color:var(--green)}
    .qp-time{font-family:var(--mono);font-size:11px;text-align:right;color:#5A6474}

    /* draw */
    .qp-colors{display:flex;gap:9px;margin-top:14px;align-items:center}
    .qp-color{width:42px;height:42px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 2px #C9C2B0;cursor:pointer;touch-action:manipulation}
    .qp-color[aria-checked=true]{box-shadow:0 0 0 3px var(--navy)}
    .qp-size{margin-left:auto;width:46px;height:42px;border-radius:12px;border:2px solid var(--navy);background:#fff;font-size:14px;cursor:pointer}
    .qp-canvas{display:block;width:100%;aspect-ratio:1/1;margin-top:12px;background:#fff;border:2.5px solid var(--navy);border-radius:18px;touch-action:none}

    /* send */
    .qp-send{background:#FFF8DD}
    .qp-summary{margin-top:14px;display:grid;gap:6px;font-size:15px}
    .qp-grownups{margin-top:20px;padding-top:14px;border-top:2px dashed #D9CC9E;font-size:13.5px;line-height:1.5}
    .qp-grownups p{margin-top:6px}.qp-grownups p[lang=es]{color:#5A6474}

    .qp-credit{margin-top:34px;display:grid;grid-template-columns:auto 1fr;gap:16px;align-items:center}
    .qp-credit img{display:block;height:64px;width:auto}
    .qp-credit p{font-size:12.5px;line-height:1.5;color:#5A6474}
  </style>

  <style is:global>
    /* Nodes created by the script below: global on purpose, see above. */
    .qp-glyph svg{width:36px;height:22px;display:block}
    .qp-glyph svg circle,.qp-glyph svg rect{fill:currentColor}
    .qp-glyph svg path{stroke:currentColor;fill:none;stroke-width:4;stroke-linecap:round;stroke-linejoin:round}
    .qp-cell svg{width:78%;height:auto;display:block}
    .qp-cell svg circle,.qp-cell svg rect{fill:currentColor}
    .qp-cell svg path{stroke:currentColor;fill:none;stroke-width:4.5;stroke-linecap:round;stroke-linejoin:round}
    .qp-summary div{background:#fff;border:2px solid #E4D9B5;border-radius:12px;padding:9px 12px}
  </style>

  <script>
    const root = document.getElementById('qp');
    const CONTACT = root.dataset.contact;
    const STEPS = Number(root.dataset.steps);
    const $ = (s, r = document) => r.querySelector(s);
    const $$ = (s, r = document) => [...r.querySelectorAll(s)];

    // ── audio ───────────────────────────────────────────────
    // Web Audio only starts after a tap, which every sound here waits for.
    // audioSession = 'playback' lets an iPhone play it even with the silent
    // switch on; where that API does not exist, nothing happens.
    let ctx = null, master = null, noiseBuf = null;
    function audio() {
      if (!ctx) {
        try { if (navigator.audioSession) navigator.audioSession.type = 'playback'; } catch (e) {}
        const AC = window.AudioContext || window.webkitAudioContext;
        ctx = new AC();
        master = ctx.createGain();
        master.gain.value = 0.8;
        const comp = ctx.createDynamicsCompressor();
        master.connect(comp); comp.connect(ctx.destination);
      }
      if (ctx.state === 'suspended') ctx.resume();
      return ctx;
    }
    const mtof = (m) => 440 * Math.pow(2, (m - 69) / 12);

    // A bowed-string-ish voice: two detuned saws, a low-pass, vibrato, envelope.
    function bow(midi, t, dur, o = {}) {
      const c = audio();
      const f = mtof(midi);
      const vol = o.vol ?? 0.22, bright = o.bright ?? 2600;
      const g = c.createGain();
      const lp = c.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = bright; lp.Q.value = 0.6;
      const lfo = c.createOscillator(); lfo.frequency.value = o.vibRate ?? 5.4;
      const lg = c.createGain(); lg.gain.value = f * (o.vibDepth ?? 0.004);
      lfo.connect(lg);
      const oscs = [0, 8].map((det) => {
        const osc = c.createOscillator(); osc.type = 'sawtooth'; osc.detune.value = det;
        osc.frequency.setValueAtTime(f, t);
        if (o.bend) {
          osc.frequency.linearRampToValueAtTime(f * Math.pow(2, o.bend / 12), t + dur * 0.45);
          osc.frequency.linearRampToValueAtTime(f, t + dur * 0.9);
        }
        lg.connect(osc.frequency); osc.connect(lp); return osc;
      });
      lp.connect(g); g.connect(o.out || master);
      const a = Math.min(0.07, dur * 0.3), r = Math.min(0.22, dur * 0.45);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(vol, t + a);
      g.gain.setValueAtTime(vol, t + Math.max(a, dur - r));
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      [...oscs, lfo].forEach((x) => { x.start(t); x.stop(t + dur + 0.05); });
    }
    // A plucked string: pizzicato, like Ravel's second movement.
    function pluck(midi, t, o = {}) {
      const c = audio();
      const g = c.createGain();
      const lp = c.createBiquadFilter(); lp.type = 'lowpass';
      lp.frequency.setValueAtTime(o.bright ?? 3200, t);
      lp.frequency.exponentialRampToValueAtTime(500, t + 0.3);
      const osc = c.createOscillator(); osc.type = 'triangle'; osc.frequency.value = mtof(midi);
      osc.connect(lp); lp.connect(g); g.connect(master);
      const vol = o.vol ?? 0.35;
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(vol, t + 0.005);
      g.gain.exponentialRampToValueAtTime(0.0001, t + (o.len ?? 0.35));
      osc.start(t); osc.stop(t + (o.len ?? 0.35) + 0.05);
    }
    function tone(freq, t, dur, type = 'sine', vol = 0.2, freqEnd) {
      const c = audio();
      const osc = c.createOscillator(); osc.type = type;
      osc.frequency.setValueAtTime(freq, t);
      if (freqEnd) osc.frequency.exponentialRampToValueAtTime(freqEnd, t + dur);
      const g = c.createGain();
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(vol, t + Math.min(0.02, dur / 4));
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      osc.connect(g); g.connect(master); osc.start(t); osc.stop(t + dur + 0.05);
    }
    function hiss(t, dur, o = {}) {
      const c = audio();
      if (!noiseBuf) {
        noiseBuf = c.createBuffer(1, c.sampleRate * 2, c.sampleRate);
        const d = noiseBuf.getChannelData(0);
        for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
      }
      const src = c.createBufferSource(); src.buffer = noiseBuf; src.loop = true;
      const flt = c.createBiquadFilter(); flt.type = o.type || 'lowpass'; flt.Q.value = o.q ?? 1;
      flt.frequency.setValueAtTime(o.freq ?? 800, t);
      if (o.freqEnd) flt.frequency.exponentialRampToValueAtTime(o.freqEnd, t + dur * (o.sweepAt ?? 1));
      if (o.freqBack) flt.frequency.exponentialRampToValueAtTime(o.freqBack, t + dur);
      const g = c.createGain();
      const vol = o.vol ?? 0.3, at = o.attack ?? 0.05;
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(vol, t + at);
      g.gain.setValueAtTime(vol, t + Math.max(at, dur - (o.release ?? 0.2)));
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      src.connect(flt); flt.connect(g); g.connect(master);
      src.start(t, Math.random()); src.stop(t + dur + 0.05);
    }

    // ── the ten neighbourhood sounds ───────────────────────
    // Drawn with synthesis, not recordings: cartoon versions of each sound,
    // so the page ships no audio files and records nothing.
    const SOUND = {
      subway(t) { hiss(t, 2.2, { freq: 160, vol: 0.5, attack: 0.5, release: 0.7 });
                  tone(659, t + 1.6, 0.5, 'sine', 0.18); tone(523, t + 2.05, 0.7, 'sine', 0.18); return 2.8; },
      birds(t)  { [0, .18, .5, .66, 1.1].forEach((d, i) => tone(2600 + i * 120, t + d, 0.11, 'sine', 0.14, 4200)); return 1.3; },
      voices(t) { for (let i = 0; i < 9; i++) { const c = audio(); const tt = t + i * 0.17;
                    const o = c.createOscillator(); o.type = 'sawtooth'; o.frequency.value = 140 + Math.random() * 120;
                    const bp = c.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = 700 + Math.random() * 900; bp.Q.value = 4;
                    const g = c.createGain(); g.gain.setValueAtTime(0.0001, tt);
                    g.gain.exponentialRampToValueAtTime(0.25, tt + 0.03); g.gain.exponentialRampToValueAtTime(0.0001, tt + 0.15);
                    o.connect(bp); bp.connect(g); g.connect(master); o.start(tt); o.stop(tt + 0.2); }
                  return 1.6; },
      music(t)  { [60, 64, 67, 72, 67, 64, 60].forEach((m, i) => pluck(m + 12, t + i * 0.14)); return 1.2; },
      horns(t)  { [0, 0.45].forEach((d) => { tone(349, t + d, 0.3, 'square', 0.07); tone(440, t + d, 0.3, 'square', 0.07); }); return 0.9; },
      planes(t) { hiss(t, 3, { freq: 300, freqEnd: 1400, sweepAt: 0.5, freqBack: 350, vol: 0.35, attack: 1, release: 1.2 }); return 3.1; },
      rain(t)   { hiss(t, 2.2, { type: 'highpass', freq: 2500, vol: 0.12, attack: 0.3, release: 0.5 });
                  for (let i = 0; i < 26; i++) hiss(t + Math.random() * 2, 0.03, { type: 'bandpass', freq: 2000 + Math.random() * 3000, q: 3, vol: 0.25, attack: 0.003, release: 0.02 });
                  return 2.3; },
      dogs(t)   { [0, 0.32].forEach((d) => tone(220, t + d, 0.17, 'sawtooth', 0.2, 95)); return 0.6; },
      steps(t)  { [0, .38, .76, 1.14].forEach((d) => hiss(t + d, 0.08, { freq: 420, vol: 0.5, attack: 0.004, release: 0.06 })); return 1.3; },
      wind(t)   { hiss(t, 2.6, { type: 'bandpass', q: 3, freq: 350, freqEnd: 1300, sweepAt: 0.55, freqBack: 450, vol: 0.4, attack: 0.6, release: 0.8 }); return 2.7; },
    };

    // ── state, kept in the link and in this browser only ────
    const state = {
      grid: Array.from({ length: 4 }, () => Array(STEPS).fill(0)),
      sounds: 0,                 // bitmask over the 10 sounds
      feel: [0, 0, 0],           // bitmask over 8 feelings, one per composer
    };
    const COMPS = ['mozart', 'ravel', 'price'];

    function encode() {
      const m = state.grid.map((l) => l.join('')).join('');
      const f = state.feel.map((x) => x.toString(16).padStart(2, '0')).join('');
      return `m=${m}&s=${state.sounds.toString(36)}&f=${f}`;
    }
    function decode(str) {
      const p = new URLSearchParams(str);
      const m = p.get('m');
      if (!m || !/^[0-4]+$/.test(m) || m.length !== 4 * STEPS) return false;
      for (let l = 0; l < 4; l++) for (let s = 0; s < STEPS; s++) state.grid[l][s] = Number(m[l * STEPS + s]);
      const s = parseInt(p.get('s') || '0', 36); state.sounds = Number.isFinite(s) ? s & 1023 : 0;
      const f = p.get('f') || '';
      for (let i = 0; i < 3; i++) { const v = parseInt(f.slice(i * 2, i * 2 + 2), 16); state.feel[i] = Number.isFinite(v) ? v & 255 : 0; }
      return true;
    }
    function save() { try { localStorage.setItem('qmp-v1', encode()); } catch (e) {} renderSummary(); }

    // ── compose ─────────────────────────────────────────────
    const GLYPH = {
      1: '<svg viewBox="0 0 40 24"><circle cx="20" cy="12" r="7"/></svg>',
      2: '<svg viewBox="0 0 40 24"><rect x="3" y="8" width="34" height="8" rx="4"/></svg>',
      3: '<svg viewBox="0 0 40 24"><path d="M4 12 C10 1, 14 1, 20 12 S30 23, 36 12"/></svg>',
      4: '<svg viewBox="0 0 40 24"><path d="M4 20 L12 5 L20 20 L28 5 L36 20"/></svg>',
    };
    $$('[data-glyph]').forEach((el) => { el.innerHTML = GLYPH[el.dataset.glyph]; });

    // Every pitch is in C major pentatonic, so any combination a child taps
    // sounds consonant. One row of pitches per instrument, one per step.
    const PITCH = [
      [79, 81, 84, 81, 79, 76, 79, 84],   // violin 1
      [72, 74, 76, 79, 76, 74, 72, 76],   // violin 2
      [67, 64, 62, 64, 67, 69, 67, 64],   // viola
      [48, 43, 48, 45, 43, 48, 45, 48],   // cello
    ];
    const VOICE = [
      { vol: 0.16, bright: 3200 }, { vol: 0.16, bright: 2800 },
      { vol: 0.2, bright: 2000 },  { vol: 0.28, bright: 1300 },
    ];
    let brush = 1;
    const cells = $$('.qp-cell');
    function paintCell(btn) {
      const v = state.grid[btn.dataset.lane][btn.dataset.step];
      btn.classList.toggle('on', v > 0);
      btn.innerHTML = v ? GLYPH[v] : '';
    }
    cells.forEach((btn) => {
      paintCell(btn);
      btn.addEventListener('click', () => {
        const l = Number(btn.dataset.lane), s = Number(btn.dataset.step);
        state.grid[l][s] = state.grid[l][s] === brush ? 0 : brush;
        paintCell(btn);
        if (state.grid[l][s]) { const c = audio(); playShape(l, s, state.grid[l][s], c.currentTime + 0.01, 0.42); }
        save();
      });
    });
    $$('.qp-brush').forEach((b) => b.addEventListener('click', () => {
      brush = Number(b.dataset.brush);
      $$('.qp-brush').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
    }));

    function playShape(lane, step, shape, t, stepDur) {
      const p = PITCH[lane][step], v = VOICE[lane];
      if (shape === 1) pluck(p, t, { vol: v.vol * 1.8, bright: v.bright });
      else if (shape === 2) bow(p, t, stepDur * 1.9, v);
      else if (shape === 3) bow(p, t, stepDur * 1.6, { ...v, bend: 1, vibDepth: 0.012, vibRate: 7 });
      else if (shape === 4) [0, 12, 0].forEach((d, i) => bow(p + d, t + i * stepDur / 3, stepDur / 3 * 0.95, v));
    }

    let playTimer = null;
    const STEP_DUR = 0.42;
    function stopComp() {
      clearTimeout(playTimer); playTimer = null;
      cells.forEach((c) => c.classList.remove('now'));
      $('#comp-play').textContent = '▶ Play · Tocar';
    }
    $('#comp-play').addEventListener('click', () => {
      if (playTimer !== null) { stopComp(); return; }
      audio();
      $('#comp-play').textContent = '■ Stop · Parar';
      let step = 0;
      const tick = () => {
        const t = ctx.currentTime + 0.03;
        cells.forEach((c) => c.classList.toggle('now', Number(c.dataset.step) === step));
        for (let l = 0; l < 4; l++) if (state.grid[l][step]) playShape(l, step, state.grid[l][step], t, STEP_DUR);
        step = (step + 1) % STEPS;
        playTimer = setTimeout(tick, STEP_DUR * 1000);
      };
      tick();
    });
    $('#comp-clear').addEventListener('click', () => {
      stopComp();
      state.grid.forEach((l) => l.fill(0)); cells.forEach(paintCell); save();
    });

    // ── conduct: Clementine, the folk song in Price's quartet ──
    // [midi, beats]. Public-domain tune, written out here; not Price's setting.
    const CLEM = [
      [67,.5],[67,.5],[67,1.5],[72,.5],[76,.5],[76,.5],[76,1.5],[72,.5],[72,.5],[76,.5],
      [79,1.5],[79,.5],[77,.5],[76,.5],[74,3],
      [74,.5],[76,.5],[77,1.5],[77,.5],[76,.5],[74,.5],[76,1.5],[72,.5],[72,.5],[76,.5],
      [74,1.5],[67,.5],[71,.5],[74,.5],[72,3],
    ];
    const TEMPI = [[66, 'Slow · Lento'], [96, 'Medium · Medio'], [138, 'Fast · Rápido']];
    const VOLS = [[0.09, 'Soft · Suave'], [0.2, 'Medium · Medio'], [0.4, 'Loud · Fuerte']];
    let tempoI = 1, volI = 1, condTimer = null, noteI = 0;
    const baton = $('#baton');
    function meters() { $('#cond-tempo').textContent = TEMPI[tempoI][1]; $('#cond-vol').textContent = VOLS[volI][1]; }
    meters();
    function condNext() {
      const [m, beats] = CLEM[noteI];
      const dur = beats * 60 / TEMPI[tempoI][0];
      bow(m, ctx.currentTime + 0.02, dur * 0.95, { vol: VOLS[volI][0], bright: 2800 });
      baton.classList.add('pulse'); setTimeout(() => baton.classList.remove('pulse'), 110);
      noteI = (noteI + 1) % CLEM.length;
      condTimer = setTimeout(condNext, dur * 1000);
    }
    function condStop() { clearTimeout(condTimer); condTimer = null; $('#cond-start').classList.remove('is-on'); }
    $('#cond-start').addEventListener('click', () => {
      audio();
      if (condTimer !== null) return;
      noteI = 0; $('#cond-start').classList.add('is-on'); condNext();
    });
    $$('[data-cond]').forEach((b) => b.addEventListener('click', () => {
      const k = b.dataset.cond;
      if (k === 'stop') { condStop(); return; }
      if (k === 'loud') volI = Math.min(2, volI + 1);
      if (k === 'soft') volI = Math.max(0, volI - 1);
      if (k === 'fast') tempoI = Math.min(2, tempoI + 1);
      if (k === 'slow') tempoI = Math.max(0, tempoI - 1);
      meters();
      baton.style.fontSize = ['48px', '64px', '86px'][volI];
    }));

    // ── listen: feelings, one set per composer ──────────────
    $$('.qp-comp').forEach((card) => {
      const ci = COMPS.indexOf(card.dataset.comp);
      $$('[data-feel]', card).forEach((chip) => {
        const bit = 1 << Number(chip.dataset.feel);
        const sync = () => chip.setAttribute('aria-pressed', String(!!(state.feel[ci] & bit)));
        sync();
        chip.addEventListener('click', () => { state.feel[ci] ^= bit; sync(); save(); });
      });
    });

    // ── sounds: tap to hear, tap to keep ────────────────────
    $$('[data-snd]').forEach((btn) => {
      const bit = 1 << Number(btn.dataset.i);
      const sync = () => btn.setAttribute('aria-pressed', String(!!(state.sounds & bit)));
      sync();
      btn.addEventListener('click', () => {
        const c = audio();
        const len = SOUND[btn.dataset.snd](c.currentTime + 0.02);
        btn.classList.add('playing'); setTimeout(() => btn.classList.remove('playing'), len * 1000);
        state.sounds ^= bit; sync(); save();
      });
    });

    // ── draw ────────────────────────────────────────────────
    const canvas = $('#canvas'), g2 = canvas.getContext('2d');
    let color = '#1F2A3C', sizeI = 1, drawing = false, last = null;
    const SIZES = [5, 12, 26];
    function fitCanvas() {
      const keep = canvas.width ? canvas.toDataURL() : null;
      const r = canvas.getBoundingClientRect(), dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr);
      g2.setTransform(dpr, 0, 0, dpr, 0, 0);
      g2.fillStyle = '#fff'; g2.fillRect(0, 0, r.width, r.height);
      if (keep) { const img = new Image(); img.onload = () => g2.drawImage(img, 0, 0, r.width, r.height); img.src = keep; }
    }
    fitCanvas();
    let resizeT; window.addEventListener('resize', () => { clearTimeout(resizeT); resizeT = setTimeout(fitCanvas, 200); });
    const pt = (e) => { const r = canvas.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; };
    canvas.addEventListener('pointerdown', (e) => { drawing = true; last = pt(e); canvas.setPointerCapture(e.pointerId); dot(last); });
    canvas.addEventListener('pointermove', (e) => { if (!drawing) return; const p = pt(e); line(last, p); last = p; });
    ['pointerup', 'pointercancel', 'pointerleave'].forEach((ev) => canvas.addEventListener(ev, () => { drawing = false; }));
    function dot(p) { g2.fillStyle = color; g2.beginPath(); g2.arc(p.x, p.y, SIZES[sizeI] / 2, 0, Math.PI * 2); g2.fill(); }
    function line(a, p) { g2.strokeStyle = color; g2.lineWidth = SIZES[sizeI]; g2.lineCap = 'round'; g2.lineJoin = 'round';
                          g2.beginPath(); g2.moveTo(a.x, a.y); g2.lineTo(p.x, p.y); g2.stroke(); }
    $$('.qp-color').forEach((b) => b.addEventListener('click', () => {
      color = b.dataset.color; $$('.qp-color').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
    }));
    $$('.qp-color').forEach((b) => { b.style.background = b.dataset.color; });
    $('#size').addEventListener('click', () => { sizeI = (sizeI + 1) % 3; $('#size').style.fontSize = ['9px', '14px', '24px'][sizeI]; });
    $('#draw-clear').addEventListener('click', () => { const r = canvas.getBoundingClientRect(); g2.fillStyle = '#fff'; g2.fillRect(0, 0, r.width, r.height); });
    $('#draw-save').addEventListener('click', () => {
      canvas.toBlob(async (blob) => {
        if (!blob) return;
        const file = new File([blob], 'queens-musical-passport-drawing.png', { type: 'image/png' });
        try {
          if (navigator.canShare && navigator.canShare({ files: [file] })) {
            await navigator.share({ files: [file], title: 'The Queens Musical Passport' });
            return;
          }
        } catch (e) { if (e && e.name === 'AbortError') return; }
        const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = file.name;
        document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 4000);
      }, 'image/png');
    });

    // ── send ────────────────────────────────────────────────
    const SND_NAMES = $$('[data-snd]').map((b) => b.querySelector('b').textContent);
    const FEEL_NAMES = $$('.qp-comp')[0] ? $$('[data-feel]', $$('.qp-comp')[0]).map((b) => b.querySelector('b').textContent) : [];
    const COMP_NAMES = ['Mozart', 'Ravel', 'Price'];
    function link() { return `${location.origin}${location.pathname}#${encode()}`; }
    function renderSummary() {
      const notes = state.grid.flat().filter(Boolean).length;
      const snds = SND_NAMES.filter((_, i) => state.sounds & (1 << i));
      const feels = state.feel.map((f, ci) => {
        const names = FEEL_NAMES.filter((_, i) => f & (1 << i));
        return names.length ? `${COMP_NAMES[ci]}: ${names.join(', ')}` : null;
      }).filter(Boolean);
      $('#summary').innerHTML =
        `<div>🎻 <b>${notes}</b> ${notes === 1 ? 'note' : 'notes'} in your music · notas en tu música</div>` +
        `<div>🏙️ ${snds.length ? snds.join(', ') : '—'}</div>` +
        `<div>👂 ${feels.length ? feels.join(' · ') : '—'}</div>`;
    }
    $('#send-mail').addEventListener('click', () => {
      const subject = 'My music for The Queens Musical Passport · Mi música para el Pasaporte';
      const body = `Hi Guillermo! Here is my music for the Passport.\n¡Hola Guillermo! Aquí está mi música para el Pasaporte.\n\n${link()}\n`;
      location.href = `mailto:${CONTACT}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
    $('#send-share').addEventListener('click', async () => {
      const url = link();
      try {
        if (navigator.share) { await navigator.share({ title: 'The Queens Musical Passport', text: 'Listen to my music! · ¡Escucha mi música!', url }); return; }
      } catch (e) { if (e && e.name === 'AbortError') return; }
      try { await navigator.clipboard.writeText(url); $('#send-share').textContent = '✓ Link copied · Enlace copiado'; } catch (e) { prompt('Copy this link', url); }
    });

    // ── start: a shared link wins over what this browser remembers ──
    function syncAll() {
      cells.forEach(paintCell);
      $$('[data-snd]').forEach((b) => {
        const on = (state.sounds & (1 << Number(b.dataset.i))) !== 0;
        b.setAttribute('aria-pressed', String(on));
      });
      $$('.qp-comp').forEach((card) => {
        const ci = COMPS.indexOf(card.dataset.comp);
        $$('[data-feel]', card).forEach((c) => {
          const on = (state.feel[ci] & (1 << Number(c.dataset.feel))) !== 0;
          c.setAttribute('aria-pressed', String(on));
        });
      });
    }
    const fromLink = location.hash.length > 1 && decode(location.hash.slice(1));
    if (fromLink) {
      $('#qp-banner').hidden = false;
      syncAll();
      setTimeout(() => $('#compose').scrollIntoView({ behavior: 'smooth' }), 300);
    } else {
      try {
        const saved = localStorage.getItem('qmp-v1');
        if (saved && decode(saved)) syncAll();
      } catch (e) {}
    }
    renderSummary();
  </script>
</AppLayout>
