---
import AppLayout from '../layouts/AppLayout.astro';
import { press, adarPress } from '../data/site.js';

const _base = import.meta.env.BASE_URL || '/';
const b = _base.endsWith('/') ? _base : _base + '/';
---
<AppLayout title="Press · Guillermo Laporta" description="Selected press coverage of CreArtBox, Festival ADAR and Guillermo Laporta's productions.">
  <div class="subpage-head">
    <a class="subpage-back" href={b}>← Home</a>
    <div class="subpage-num">06 · Press</div>
    <h1 class="subpage-title">Selected press.</h1>
    <p class="subpage-sub">Coverage of CreArtBox, Festival ADAR and Guillermo Laporta's productions. {adarPress.length} pieces on the festival from the Asturian and Spanish press.</p>
  </div>

  <section class="section section-tight">
    <div class="press-grid">
      {press.map((item) => (
        <div class="press-card">
          <div class="press-quote">{item.quote}</div>
          <div class="press-source">{item.source}</div>
        </div>
      ))}
    </div>

    <div style="margin-top:72px;padding-top:40px;border-top:1px solid var(--line-soft)">
      <div class="disco-section-label">Festival ADAR in the press</div>
      <p class="ap-note">
        Asturian and national coverage of the festival, newest first. Each one opens the
        clipping in the festival's own press archive.
      </p>
      <ol class="ap-list">
        {adarPress.map((item) => (
          <li class="ap-item">
            <a class="ap-link" href={item.url} target="_blank" rel="noopener">
              <div class="ap-meta">
                <span class="ap-outlet">{item.outlet}</span>
                <span class="ap-date">{item.displayDate}</span>
                {item.byline && <span class="ap-byline">{item.byline}</span>}
              </div>
              <h3 class="ap-title">{item.title}</h3>
              <p class="ap-lede">{item.lede}</p>
            </a>
          </li>
        ))}
      </ol>
    </div>

    <div style="margin-top:72px;padding-top:40px;border-top:1px solid var(--line-soft)">
      <div class="disco-section-label">Press kit</div>
      <p style="font-size:15px;line-height:1.65;color:var(--ink-2);margin-bottom:28px">Press photos, CV and bio available for download.</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px">
        <a class="btn primary" href={`${b}downloads/guillermo-laporta-cv.pdf`} target="_blank">CV (PDF) ↗</a>
        <a class="btn" href={`${b}downloads/laporta-press-photo-1.jpg`} target="_blank">Press photo 1</a>
        <a class="btn" href={`${b}downloads/laporta-press-photo-2.jpg`} target="_blank">Press photo 2</a>
        <a class="btn" href="mailto:guillermo@creartbox.nyc">Press enquiries</a>
      </div>
    </div>
  </section>

  <style>
    .section-tight{padding-top:0;max-width:1480px;margin:0 auto;padding-left:40px;padding-right:40px;padding-bottom:96px}
    @media(max-width:720px){.section-tight{padding-left:20px;padding-right:20px;padding-bottom:56px}}

    .ap-note{font-size:15px;line-height:1.6;color:var(--ink-2);max-width:62ch;margin-bottom:28px}

    .ap-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--line-soft);max-width:1100px}
    .ap-item{border-bottom:1px solid var(--line-soft)}
    .ap-link{display:block;padding:18px 2px;transition:background .18s,padding .18s}
    .ap-link:hover{background:var(--bg-warm);padding-left:12px;padding-right:12px}

    .ap-meta{
      display:flex;flex-wrap:wrap;gap:6px 16px;margin-bottom:7px;
      font-family:var(--mono);font-size:9.5px;letter-spacing:.14em;
      text-transform:uppercase;color:var(--muted);
    }
    .ap-outlet{color:var(--ink-2)}
    .ap-byline{font-style:normal}

    .ap-title{
      font-family:var(--serif);font-weight:500;font-size:19px;line-height:1.22;
      letter-spacing:-.01em;color:var(--ink);margin-bottom:5px;
    }
    .ap-link:hover .ap-title{color:var(--accent)}
    .ap-lede{font-size:14px;line-height:1.5;color:var(--ink-2);max-width:78ch}

    @media(max-width:720px){
      .ap-title{font-size:17px}
      .ap-lede{font-size:13.5px}
    }
  </style>
</AppLayout>
