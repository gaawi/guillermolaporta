---
import AppLayout from '../layouts/AppLayout.astro';

const _base = import.meta.env.BASE_URL || '/';
const b = _base.endsWith('/') ? _base : _base + '/';

const CDN = 'https://creartbox-media-cdn.b-cdn.net';
const WP  = 'https://play.creartbox.nyc/wp-content/uploads';

const recordings = [
  {
    composer: 'György Ligeti',
    title: 'Musica Ricercata',
    year: '2025',
    role: 'Flute · Arr.',
    type: 'video',
    cover: `${CDN}/webimg/projects_photos/20251212/comp/_MG_0161.jpg`,
    embed: 'https://iframe.mediadelivery.net/embed/449741/4214c16c-1c0a-4bdc-b4de-6b93bf95246e?autoplay=true&loop=false&muted=false&preload=true&responsive=true',
  },
  {
    composer: 'Devin Cholodenko',
    title: 'Twilight at Dawn',
    year: '2024',
    role: 'Flute',
    type: 'video',
    cover: `${WP}/DSC0028-scaled.jpg`,
    embed: 'https://iframe.mediadelivery.net/embed/449741/34b94837-4267-4e67-b6df-fb50ea4c55e1?autoplay=true&loop=false&muted=false&preload=true&responsive=true',
    note: 'World premiere',
  },
  {
    composer: 'Antonín Dvořák',
    title: 'American Quartet — String Quartet No. 12',
    year: '2024',
    role: 'Flute · Arr.',
    type: 'audio',
    cover: `${WP}/IMG_3176-scaled.png`,
    tracks: [
      { label: 'I. Allegro ma non troppo', src: `${CDN}/webimg/projects_photos/20241211/audio/07DvorakI.mp3` },
      { label: 'II. Lento', src: `${CDN}/webimg/projects_photos/20241211/audio/08DvorakII.mp3` },
      { label: 'III. Molto vivace — Trio', src: `${CDN}/webimg/projects_photos/20241211/audio/09DvorakIII.mp3` },
