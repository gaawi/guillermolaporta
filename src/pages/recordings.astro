  },
  {
    composer: 'Annamaria Kowalsky',
    title: 'Heart Meditation',
    year: '2023',
    role: 'Flute',
    type: 'video',
    cover: `${WP}/056-scaled.jpg`,
    embed: 'https://iframe.mediadelivery.net/embed/449741/67fbe759-5a8f-4ea0-8a1c-95d82741c0fb?autoplay=true&loop=false&muted=false&preload=true&responsive=true',
  },
  {
    composer: 'Enrique Granados',
    title: 'Piano Quintet in G minor, Op. 49',
    year: '2023',
    role: 'Flute',
    type: 'video',
    cover: `${WP}/DSC00357-2.jpg`,
    embed: 'https://iframe.mediadelivery.net/embed/449741/925210c7-f30b-4a8a-b7e8-8f4d26c8150a?autoplay=true&loop=false&muted=false&preload=true&responsive=true',
  },
  {
    composer: 'Andrea Casarrubios',
    title: 'Afilador',
    year: '2023',
    role: 'Flute',
    type: 'video',
    cover: `${WP}/002.jpg`,
    embed: 'https://iframe.mediadelivery.net/embed/449741/d6914ec2-693c-4013-805e-356129f0375c?autoplay=true&loop=false&muted=false&preload=true&responsive=true',
  },
  {
    composer: 'Hannah Selin',
    title: 'Chesapeake',
    year: '2023',
    role: 'Flute',
    type: 'video',
    cover: `${WP}/004-4.jpg`,
    embed: 'https://iframe.mediadelivery.net/embed/449741/096b2a96-cb99-4581-92a8-50e5580b3688?autoplay=true&loop=false&muted=false&preload=true&responsive=true',
  },
  {
    composer: 'Modest Mussorgsky',
    title: 'Pictures at an Exhibition',
    year: '2023',
    role: 'Flute · Arr.',
    type: 'video',
    cover: `${WP}/pictures2.jpg`,
    embed: 'https://iframe.mediadelivery.net/embed/449741/b4dc09b9-0cfa-41a4-b6b8-101953bfaee5?autoplay=true&loop=false&muted=false&preload=true&responsive=true',
  },
  {
    composer: 'Joan Tower',
    title: 'Petroushkates',
    year: '2023',
    role: 'Flute',
    type: 'audio',
    cover: `${WP}/016.jpg`,
    tracks: [
      { label: 'Petroushkates', src: `${WP}/Petroushkates.mp3` },
    ],
  },
  {
    composer: 'Marcos Fernández',
    title: 'Noctum — Concerto for flute and clarinet',
    year: '2022',
    role: 'Flute',
    type: 'audio',
    cover: `${WP}/013.jpg`,
    tracks: [
      { label: 'Noctum Concerto for flute and clarinet', src: `${WP}/Marcos-Fernandez-Flute-clarinet-concierto-remastered-2022.wav` },
    ],
  },
  {
    composer: 'Bryan M. Wysocki',
    title: 'We Can Learn Me Together',
    year: '2021',
    role: 'Flute',
    type: 'video',
    cover: `${WP}/DSC05348-scaled.jpg`,
    embed: 'https://iframe.mediadelivery.net/embed/449741/ce34a5c8-942a-40e2-a9f8-d960eaafb8a1?autoplay=true&loop=false&muted=false&preload=true&responsive=true',
    note: 'NY Premiere',
  },
  {
    composer: 'André Jolivet',
    title: 'Petite Suite',
    year: '2021',
    role: 'Flute',
    type: 'audio',
    cover: `${WP}/ADS_0835.jpg`,
    tracks: [
      { label: 'I–V. Petite Suite', src: 'https://media.creartbox.nyc/audios/20211204/Petite%20suite%20by%20Andre%20Jolivet.mp3' },
    ],
  },
  {
    composer: 'Antonio Vivaldi',
    title: 'La Notte, RV 439',
    year: '2021',
    role: 'Flute',
    type: 'video',
    cover: `${WP}/circlenoirphoto2.jpg`,
    embed: 'https://iframe.mediadelivery.net/embed/449741/73ab8300-a9b0-403a-9c15-25e00fddfd55?autoplay=true&loop=false&muted=false&preload=true&responsive=true',
  },
  {
    composer: 'Claude Debussy',
    title: 'Deuxième Sonate en trio',
    year: '2021',
    role: 'Flute',
    type: 'video',
    cover: `${WP}/002-3.jpg`,
    embed: 'https://iframe.mediadelivery.net/embed/449741/64946dd5-307a-4ab6-9027-c02023c7cfd9?autoplay=true&loop=false&muted=false&preload=true&responsive=true',
  },
  {
    composer: 'Tatiana Nikolayeva',
    title: 'Trio Op. 18',
    year: '2021',
    role: 'Flute',
    type: 'video',
    cover: `${WP}/DSC05267-scaled.jpg`,
    embed: 'https://iframe.mediadelivery.net/embed/449741/e6ae9bde-a67f-4dfa-af00-8fdf14ca5d84?autoplay=true&loop=false&muted=false&preload=true&responsive=true',
  },
  {
    composer: 'Olivier Messiaen',
    title: 'Quartet for the End of Time',
    year: '2019',
    role: 'Flute',
    type: 'audio',
    cover: `${WP}/ADS_0835.jpg`,
    tracks: [
      { label: 'I – Crystal liturgy', src: `${CDN}/webimg/audios/20190830/01%20Crystal%20liturgy.mp3` },
      { label: 'II – Vocalise, for the Angel', src: `${CDN}/webimg/audios/20190830/02%20Vocalise%2C%20for%20the%20Angel%20who%20announces%20the%20end%20of%20time.mp3` },
      { label: 'III – Abyss of birds', src: `${CDN}/webimg/audios/20190830/03%20Abyss%20of%20birds.mp3` },
      { label: 'IV – Interlude', src: `${CDN}/webimg/audios/20190830/04%20Interlude.mp3` },
      { label: 'V – Praise to the eternity of Jesus', src: `${CDN}/webimg/audios/20190830/05%20Praise%20to%20the%20eternity%20of%20Jesus.mp3` },
      { label: 'VI – Dance of fury', src: `${CDN}/webimg/audios/20190830/06%20Dance%20of%20fury%2C%20for%20the%20seven%20trumpets.mp3` },
      { label: 'VII – Tangle of rainbows', src: `${CDN}/webimg/audios/20190830/07%20Tangle%20of%20rainbows%2C%20for%20the%20Angel%20who%20announces%20the%20end%20of%20time.mp3` },
      { label: 'VIII – Praise to the immortality of Jesus', src: `${CDN}/webimg/audios/20190830/08%20Praise%20to%20the%20immortality%20of%20Jesus.mp3` },
    ],
  },
];

// Keep the original array index — the player looks recordings up by it.
const indexed = recordings.map((r, i) => ({ ...r, i }));
const shelves = [
  { title: 'Video',  items: indexed.filter(r => r.type === 'video') },
  { title: 'Audio',  items: indexed.filter(r => r.type === 'audio') },
];
---
<AppLayout
  title="Recordings — Guillermo Laporta"
  description="Concert recordings of Guillermo Laporta as flutist — chamber music, original works and orchestral transcriptions."
>
  <div class="subpage-head">
    <a class="subpage-back" href={b}>← Home</a>
    <div class="subpage-num">Recordings</div>
    <h1 class="subpage-title">Live recordings.</h1>
    <p class="subpage-sub">Concert recordings — chamber music, new works and orchestral transcriptions. Press play to listen or watch.</p>
  </div>

  <section class="rec-section">
    {shelves.map((shelf) => (
      <div class="shelf">
        <div class="shelf-head">
          <h2 class="shelf-title">{shelf.title}</h2>
          <span class="shelf-count">{shelf.items.length} recordings</span>
        </div>
        <div class="shelf-viewport">
          <button class="shelf-arrow prev" data-dir="-1" aria-label={`Scroll ${shelf.title} left`} type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
          </button>
          <div class="shelf-scroller">
            {shelf.items.map((r) => (
              <button
                class={`rec-play-btn rec-card ${r.type}`}
                data-index={r.i}
                type="button"
                aria-label={r.type === 'video' ? `Watch ${r.title}` : `Listen to ${r.title}`}
              >
                <span class="rc-art">
                  <img src={r.cover} alt="" loading="lazy" />
                  <span class="rc-scrim"></span>
                  <span class="rc-kind">{r.type === 'video' ? 'Video' : 'Audio'}</span>
                  <span class="rc-play">
                    {r.type === 'video'
                      ? (<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 3 20 12 6 21 6 3"/></svg>)
                      : (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M9 18V6l13-2v12M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0m13-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/></svg>)
                    }
                  </span>
                </span>
                <span class="rc-meta">
                  <span class="rc-composer">{r.composer}</span>
                  <span class="rc-title">{r.title}</span>
                  <span class="rc-sub">{r.year} · {r.role}{r.note ? ` · ${r.note}` : ''}</span>
                </span>
              </button>
            ))}
          </div>
          <button class="shelf-arrow next" data-dir="1" aria-label={`Scroll ${shelf.title} right`} type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>
    ))}
  </section>

  <!-- ── MODAL ─────────────────────────────────────────────────────── -->
  <div class="media-modal" id="mediaModal" role="dialog" aria-modal="true">
    <div class="modal-backdrop" id="modalBackdrop"></div>
    <div class="modal-box" id="modalBox">
      <button class="modal-close" id="modalClose" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>

      <!-- Video panel -->
      <div class="modal-video-panel" id="modalVideoPanel">
        <div class="modal-iframe-wrap">
          <iframe id="modalIframe" src="" allow="accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture" allowfullscreen loading="lazy"></iframe>
        </div>
        <div class="modal-video-info" id="modalVideoInfo"></div>
      </div>

      <!-- Audio panel -->
      <div class="modal-audio-panel" id="modalAudioPanel">
        <div class="modal-audio-cover">
          <img id="modalAudioCover" src="" alt="" />
        </div>
        <div class="modal-audio-content">
          <div class="modal-audio-meta" id="modalAudioMeta"></div>
          <audio id="modalAudio" controls></audio>
          <ul class="modal-track-list" id="modalTrackList"></ul>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ recordings }}>
    const modal       = document.getElementById('mediaModal');
    const backdrop    = document.getElementById('modalBackdrop');
    const closeBtn    = document.getElementById('modalClose');
    const videoPanel  = document.getElementById('modalVideoPanel');
    const audioPanel  = document.getElementById('modalAudioPanel');
    const iframe      = document.getElementById('modalIframe');
    const videoInfo   = document.getElementById('modalVideoInfo');
    const audioEl     = document.getElementById('modalAudio');
    const audioCover  = document.getElementById('modalAudioCover');
    const audioMeta   = document.getElementById('modalAudioMeta');
    const trackList   = document.getElementById('modalTrackList');

    function openModal(idx) {
      const r = recordings[idx];
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';

      if (r.type === 'video') {
        videoPanel.style.display = '';
        audioPanel.style.display = 'none';
        iframe.src = r.embed;
        videoInfo.innerHTML = `<span class="modal-composer">${r.composer}</span> <span class="modal-title-text">${r.title}</span>`;
      } else {
        videoPanel.style.display = 'none';
        audioPanel.style.display = '';
        iframe.src = '';
        audioCover.src  = r.cover;
        audioCover.alt  = r.title;
        audioMeta.innerHTML = `<span class="modal-composer">${r.composer}</span><span class="modal-title-text">${r.title}</span>`;

        trackList.innerHTML = '';
        r.tracks.forEach((t, ti) => {
          const li = document.createElement('li');
          li.className = 'modal-track' + (ti === 0 ? ' active' : '');
          li.dataset.src = t.src;
          li.innerHTML = `<span class="track-num">${String(ti + 1).padStart(2, '0')}</span><span class="track-label">${t.label}</span>`;
          li.addEventListener('click', () => playTrack(li, t.src));
          trackList.appendChild(li);
        });
        playTrack(trackList.querySelector('.modal-track'), r.tracks[0].src);
      }
    }

    function playTrack(li, src) {
      trackList.querySelectorAll('.modal-track').forEach(t => t.classList.remove('active'));
      li.classList.add('active');
      audioEl.src = src;
      audioEl.play().catch(() => {});
    }

    function closeModal() {
      modal.classList.remove('open');
      document.body.style.overflow = '';
      iframe.src = '';
      audioEl.pause();
      audioEl.src = '';
    }

    /* ── shelf arrows ── */
    document.querySelectorAll('.shelf-viewport').forEach(vp => {
      const scroller = vp.querySelector('.shelf-scroller');
      const prev = vp.querySelector('.shelf-arrow.prev');
      const next = vp.querySelector('.shelf-arrow.next');
      if (!scroller || !prev || !next) return;

      function sync() {
        const max = scroller.scrollWidth - scroller.clientWidth;
        prev.hidden = scroller.scrollLeft <= 4;
        next.hidden = scroller.scrollLeft >= max - 4;
      }
      function page(dir) {
        scroller.scrollBy({ left: dir * scroller.clientWidth * 0.85, behavior: 'smooth' });
      }
      prev.addEventListener('click', () => page(-1));
      next.addEventListener('click', () => page(1));
      scroller.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    });

    document.querySelectorAll('.rec-play-btn').forEach(btn => {
      btn.addEventListener('click', () => openModal(Number(btn.dataset.index)));
    });
    closeBtn.addEventListener('click', closeModal);
    backdrop.addEventListener('click', closeModal);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
  </script>

  <style>
    /* ── shelves (horizontal rows) ── */
    .rec-section { padding: 0 0 88px; }

    .shelf { margin-bottom: 40px; }
    .shelf:last-child { margin-bottom: 0; }

    .shelf-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      padding: 0 40px;
      margin-bottom: 14px;
    }
    .shelf-title {
      font-family: var(--serif);
      font-size: 20px;
      font-weight: 500;
      letter-spacing: -.01em;
      color: var(--ink);
    }
    .shelf-count {
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--muted);
      white-space: nowrap;
    }

    .shelf-viewport { position: relative; }

    .shelf-scroller {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scroll-behavior: smooth;
      padding: 4px 40px 10px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .shelf-scroller::-webkit-scrollbar { display: none; }

    /* ── card ── */
    .rec-card {
      flex: 0 0 clamp(200px, 21vw, 280px);
      scroll-snap-align: start;
      display: flex;
      flex-direction: column;
      gap: 10px;
      background: none;
      border: none;
      padding: 0;
      margin: 0;
      text-align: left;
      color: inherit;
      cursor: pointer;
      transition: transform .28s cubic-bezier(.2,.7,.2,1);
    }
    .rec-card:hover, .rec-card:focus-visible { transform: scale(1.04); z-index: 2; }

    .rc-art {
      position: relative;
      display: block;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      border-radius: 3px;
      background: var(--bg-warm);
      box-shadow: 0 2px 10px -6px rgba(0,0,0,.3);
      transition: box-shadow .28s;
    }
    .rec-card:hover .rc-art { box-shadow: 0 14px 30px -14px rgba(0,0,0,.45); }
    .rc-art img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .rc-scrim {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,.45), rgba(0,0,0,0) 55%);
      opacity: .75;
      transition: opacity .28s;
    }
    .rec-card:hover .rc-scrim { opacity: .95; }

    .rc-kind {
      position: absolute; top: 8px; left: 8px;
      font-family: var(--mono);
      font-size: 8.5px;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: #fff;
      background: rgba(0,0,0,.55);
      padding: 3px 7px;
      border-radius: 2px;
      backdrop-filter: blur(3px);
    }

    .rc-play {
      position: absolute;
      left: 50%; top: 50%;
      transform: translate(-50%, -50%) scale(.85);
      width: 46px; height: 46px;
      display: grid; place-items: center;
      border-radius: 50%;
      background: rgba(255,255,255,.92);
      color: #111;
      opacity: 0;
      transition: opacity .22s, transform .22s;
    }
    .rc-play svg { width: 18px; height: 18px; }
    .rec-card:hover .rc-play,
    .rec-card:focus-visible .rc-play { opacity: 1; transform: translate(-50%, -50%) scale(1); }

    .rc-meta { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .rc-composer {
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .rc-title {
      font-family: var(--serif);
      font-size: 16px;
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: -.01em;
      color: var(--ink);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .rc-sub { font-size: 12px; color: var(--muted); line-height: 1.35; }

    /* ── arrows (desktop) ── */
    .shelf-arrow {
      position: absolute;
      top: 0;
      bottom: 18px;
      width: 40px;
      display: grid;
      place-items: center;
      border: none;
      background: color-mix(in srgb, var(--bg) 82%, transparent);
      color: var(--accent-2);
      cursor: pointer;
      opacity: 0;
      transition: opacity .2s;
      z-index: 3;
    }
    .shelf-arrow.prev { left: 0; }
    .shelf-arrow.next { right: 0; }
    .shelf-arrow svg { width: 20px; height: 20px; }
    .shelf-viewport:hover .shelf-arrow { opacity: 1; }
    .shelf-arrow:focus-visible { opacity: 1; }
    .shelf-arrow[hidden] { display: none; }

    @media (hover: none) {
      .shelf-arrow { display: none; }
      .rec-card:hover { transform: none; }
      .rc-play { opacity: 1; transform: translate(-50%, -50%) scale(1); width: 40px; height: 40px; }
    }

    @media (max-width: 720px) {
      .shelf-head { padding: 0 20px; }
      .shelf-scroller { padding: 4px 20px 10px; gap: 10px; }
      .rec-card { flex: 0 0 76vw; }
      .shelf-title { font-size: 17px; }
      .rc-title { font-size: 15px; }
    }


    /* ── modal ── */
    .media-modal {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity .25s ease;
    }
    .media-modal.open { opacity: 1; pointer-events: auto; }

    .modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, .88);
      cursor: pointer;
    }

    .modal-box {
      position: relative;
      z-index: 1;
      width: min(900px, 95vw);
      max-height: 90vh;
      overflow-y: auto;
      background: var(--paper);
      box-shadow: 0 32px 80px rgba(0,0,0,.6);
      transform: translateY(12px);
      transition: transform .25s ease;
    }
    .media-modal.open .modal-box { transform: translateY(0); }

    .modal-close {
      position: absolute;
      top: 16px;
      right: 16px;
      z-index: 2;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0,0,0,.5);
      border: none;
      border-radius: 50%;
      color: #fff;
      cursor: pointer;
      transition: background .15s;
    }
    .modal-close:hover { background: rgba(0,0,0,.8); }
    .modal-close svg { width: 18px; height: 18px; }

    /* video panel */
    .modal-video-panel { display: flex; flex-direction: column; }
    .modal-iframe-wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #000;
      overflow: hidden;
    }
    .modal-iframe-wrap iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: none;
    }
    .modal-video-info {
      padding: 16px 24px;
